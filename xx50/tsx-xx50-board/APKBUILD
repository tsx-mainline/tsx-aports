# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Board layer of the xx50 panels (TSS-752): the board file, the hardware
# facts, the CPU governor, the touch controller mode, the watchdog settings,
# the GPU module, the serial login, the front keys, the kernel slot writer,
# the good-boot service of the stock U-Boot (tsx-boot-ok), the start of the
# rescue system (tsx-boot-rescue) and the board part
# of the panel app (its environment and the default layout). It pulls in the
# automatic update (tsx-autoupdate 0.3.2 or later: the idle screen and the
# health check of the panel app) and adds its service to the default
# runlevel.
#
# Source: the signed tag board-v$pkgver of tsx-xx50-linux. The build downloads
# the GitHub archive of that tag. Its top directory is
# tsx-xx50-linux-board-v$pkgver. The package uses only rootfs/overlay of it.
# sha512sums holds the sum of the archive. After a new tag, run
# `abuild checksum` (README.md, "Source of the packages").
pkgname=tsx-xx50-board
pkgver=0.3.3
pkgrel=0
pkgdesc="TSX xx50 board layer: board file, hardware facts, governor, touch mode, watchdog, keys, kernel slots, rescue start, panel app board part"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
# tsx-touch writes two registers of the touch controller with i2cset.
# tsx-boot-ok writes the retry counters of the U-Boot env with fw_setenv.
depends="busybox kmod i2c-tools u-boot-tools tsx-autoupdate>=0.3.3"
install="$pkgname.post-install $pkgname.post-upgrade"
# /etc/securetty replaces the one of busybox (the Alpine list plus the serial
# console of the board). /etc/conf.d/watchdog replaces the one of
# busybox-openrc (the timeout of the board).
replaces="busybox busybox-openrc"
# The panel software lives in /usr/local, as in the image.
options="!check !fhs"
source="tsx-xx50-linux-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-xx50-linux/archive/refs/tags/board-v$pkgver.tar.gz"
builddir="$srcdir/tsx-xx50-linux-board-v$pkgver"

# Files below rootfs/overlay of the tag that this package owns. The image
# keeps its own files (fstab, inittab) and the apk key (tsx-keys owns it).
_files="
etc/conf.d/watchdog
etc/init.d/tsx-boot-ok
etc/init.d/tsx-cpufreq
etc/init.d/tsx-touch
etc/modules-load.d/tsx-xx50.conf
etc/securetty
etc/tsx/buttons-board.conf
etc/tsx/motd.board
etc/tsx/panel-app-board.conf
etc/tsx/panel-board.conf
etc/tsx/panel-layout.json
usr/local/lib/tsx/board.sh
usr/local/sbin/tsx-boot-ok
usr/local/sbin/tsx-boot-rescue
usr/local/sbin/tsx-hw
usr/local/sbin/tsx-kernel-slots
"

package() {
	local f
	for f in $_files; do
		[ -f "$builddir"/rootfs/overlay/$f ] || { echo "board file missing in the source: $f" >&2; return 1; }
		install -Dm"$(stat -c %a "$builddir"/rootfs/overlay/$f)" "$builddir"/rootfs/overlay/$f "$pkgdir"/$f
	done
	# The GitHub archive of a tag has group-writable files.
	chmod -R go-w "$pkgdir"
}

sha512sums="
10aaac8875359ed0ae6208ce654cea19c6c392e38474d3f07c7689a5f71a7472a6f1da158df9636016af8bbae7a036680f490bca7c8088a53a130d858bd6549b  tsx-xx50-linux-0.3.3.tar.gz
"
