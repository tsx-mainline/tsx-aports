builddir="$srcdir/tsx-xx50-panel-app-$pkgver"

build() {
	python3 -m venv "$srcdir"/pio
	"$srcdir"/pio/bin/pip install -q --no-index --no-cache-dir --disable-pip-version-check \
		--find-links "$srcdir" platformio==$_pio
	PATH="$srcdir/pio/bin:$PATH" PLATFORMIO_CORE_DIR="$srcdir"/pio-core HOME="$srcdir" \
		JOBS="${JOBS:-$(nproc)}" sh "$builddir"/compile.sh "$builddir" "$builddir"/tsx-panel-app
}

package() {
	local lic="$pkgdir"/usr/share/licenses/$pkgname
	install -Dm755 "$builddir"/tsx-panel-app "$pkgdir"/usr/local/bin/tsx-panel-app
	install -Dm644 "$builddir"/BUILDINFO "$pkgdir"/usr/local/share/tsx/panel-app/BUILDINFO.xx50
	install -d "$lic"
	install -m644 "$builddir"/LICENSE "$builddir"/NOTICE "$builddir"/licenses/* "$lic"/
	# The AGPL corresponding source is on another server than the package.
	printf '%s\n' "The corresponding source of /usr/local/bin/tsx-panel-app ($pkgname $pkgver):" \
		"$_srcurl" > "$lic"/SOURCE
}

