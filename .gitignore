# abuild work areas and build products (rebuilt by scripts/build.sh, never committed)
packages/
repo/
src/
pkg/
extract/
*.log

# staged binary inputs for the kernel packages (scripts/stage-kernel.sh output;
# large, and reproducible from the build host, so not committed)
xx60/tsx-xx60-kernel-stable/dist/
xx60/tsx-xx60-kernel-lts/dist/

# signing keys: the PRIVATE key never lives inside this repo (it stays in
# tsx-mainline/keys/, outside every repo, chmod 600, mounted read-only into
# the build container). This entry guards against an accidental copy landing
# here. The PUBLIC key is committed on purpose in common/tsx-keys/.
*.rsa
!*.rsa.pub

# abuild / apk local state
.abuild/
abuild.conf
APKBUILD.orig
*~

# staged sources of the xx50 recipes (abuild downloads, never committed)
xx50/*/dist/

# staged kernel bundles of xx70 (scripts/stage-kernel-xx70.sh keeps them on
# the build host, and a tsx-aports release holds the published copy)
xx70/*/dist/
work/

# Python byte code (a script that imports another makes it)
__pycache__/
*.pyc

# staged sources of the uc-pxx recipes: the snapshot archive of uc-pxx-linux
# (scripts/uc-pxx-source.sh) and the bundles of scripts/stage-uc-pxx-tools.sh
# and scripts/stage-kernel-uc-pxx.sh. They stay on the build host, and a
# tsx-aports release holds the published copy of a bundle.
uc-pxx/*/dist/
