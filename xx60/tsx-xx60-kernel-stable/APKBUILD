# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
#
# BINARY packaging of an already-built kernel: no compiler runs in this
# APKBUILD. source= fetches ONE release asset -- tsx-xx60-linux's
# tsx-xx60-kernel-stable-bundle.tar.zst for the tagged release
# _kbundle_tag, built by that repo's .github/workflows/release.yml (job
# "kbundle") -- and abuild auto-extracts it (a plain .tar.zst) into a
# zImage, the board DTB, the modules tree tarball, the packed eMMC boot
# image, kernel.release and kernel.commit (the last two: provenance only,
# nothing here reads them). This is how CI (which has no build host to
# stage from) builds this package. For a LOCAL build of a kernel that has
# not been tagged/released yet, ../../scripts/stage-kernel.sh still builds
# the exact same bundle format from a build host and drops it in dist/
# under the URL's own basename; SRCDEST below then makes abuild use that
# local file (verified by sha512sum, never re-fetched) instead of hitting
# the network. Either way, stage-kernel.sh fills in
# pkgver/pkgrel/_kernelrelease/sha512sums below -- do not hand-edit them.
# _kbundle_tag is CI-only and is not touched by stage-kernel.sh; bump it
# by hand once a matching tsx-xx60-linux release exists (see ../../README.md).
SRCDEST="$startdir/dist"
#
# pkgver scheme: <upstream kernel version>_git<YYYYMMDD>, e.g. 7.2.8_git20260927.
# apk pkgver cannot contain '-', so the git-describe suffix
# ("-NNNNN-gHASH") that `make kernelrelease` produces is replaced by the
# staging date; the exact commit for a given pkgver is recorded in
# _kernelrelease below (build provenance only -- nothing on the panel reads
# it).
#
# "stable" here is Alpine's sense (linux-lts / linux-stable): this is the
# latest upstream stable series (currently 7.2.x), re-based to each new
# release since a stable series goes EOL soon after the next one ships. The
# LTS flavor (tsx-xx60-kernel-lts) is the default, longer-lived kernel; this
# one is for anyone who wants the newest driver fixes sooner. Both flavors
# install side by side (own /lib/modules/<release>/, own
# /boot/tsxboot-emmc-<flavor>.img); only the SELECTED flavor's image is
# written into the eMMC boot partition (tsx-kernel-flavor, tsx-xx60-boot-tools).
pkgname=tsx-xx60-kernel-stable
pkgver=7.2.8_git20260928
pkgrel=12
_kernelrelease=7.2.8-00119-ga67b2346cec5
# tsx-xx60-linux release tag whose "kbundle" CI asset this pins. UNRELEASED
# until that repo has cut a real tag with this job in it; until then this
# package builds only from a local dist/ stage (see the header comment).
_kbundle_tag=UNRELEASED
pkgdesc="xx60 mainline kernel, latest stable line"
url="https://github.com/tsx-mainline/tsx-xx60-linux"
arch="armv7"
license="GPL-2.0-only"
depends="tsx-xx60-boot-tools>=1-r4"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade"
source="https://github.com/tsx-mainline/tsx-xx60-linux/releases/download/$_kbundle_tag/tsx-xx60-kernel-stable-bundle.tar.zst"

package() {
	install -Dm644 "$srcdir"/tsxboot-emmc.img "$pkgdir"/boot/tsxboot-emmc-stable.img
	mkdir -p "$pkgdir"/usr/share/tsx
	echo "$_kernelrelease" > "$pkgdir"/usr/share/tsx/kernel-stable.release
	mkdir -p "$pkgdir"/lib/modules
	tar -xzf "$srcdir"/modules-$_kernelrelease.tar.gz -C "$pkgdir"
	# modules_install's build/source links point into the build machine's
	# kernel build dir: meaningless on a panel, and they name that machine's paths
	rm -f "$pkgdir"/lib/modules/$_kernelrelease/build "$pkgdir"/lib/modules/$_kernelrelease/source
}

sha512sums="
42e9fcb285974cbea7c9f4c5898f3815d9595bc5928daf55b80d81d52826020ef61ffe7d3413b5f5a02688b33916a78fd65e7abdf45fbf25a5ae018a7ae011d9  tsx-xx60-kernel-stable-bundle.tar.zst
"
