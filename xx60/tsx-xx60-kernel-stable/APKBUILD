# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
#
# BINARY packaging of an already-built kernel: no compiler runs in this
# APKBUILD. source= fetches ONE release asset: the file
# tsx-xx60-kernel-stable-bundle.tar.zst of tsx-xx60-linux, for the
# tagged release _kbundle_tag. The job "kbundle" in
# .github/workflows/release.yml of that repo builds it. abuild extracts it
# automatically (it is a plain .tar.zst). The bundle contains a zImage, the
# board DTB, the modules tree tarball, the packed eMMC boot image,
# kernel.release, and kernel.commit. The last two are provenance only, and
# nothing here reads them.
# CI has no build host to stage from, so this is how CI builds the package.
# For a LOCAL build of a kernel that has no tag or release yet,
# ../../scripts/stage-kernel.sh builds the same bundle format from a build
# host. It puts the bundle in dist/ under the basename of the URL. SRCDEST
# below then makes abuild use that local file. sha512sum verifies it, and
# abuild does not fetch it again. In both cases, stage-kernel.sh writes
# pkgver, pkgrel, _kernelrelease, and sha512sums below. Do not edit them by
# hand. stage-kernel.sh does not change _kbundle_tag, and only CI uses it.
# After a new tsx-xx60-linux release, run scripts/pin-kernel.sh TAG. It writes
# _kbundle_tag, _kernelrelease and sha512sums from the bundle of that release
# (see ../../README.md).
SRCDEST="$startdir/dist"
#
# pkgver scheme: <upstream kernel version>_git<YYYYMMDD>, for example
# 7.2.8_git20260927. An apk pkgver cannot contain '-'. The staging date
# replaces the git-describe suffix ("-NNNNN-gHASH") of `make kernelrelease`.
# The variable _kernelrelease below records the exact commit for a pkgver.
# This is build provenance only, and nothing on the panel reads it.
#
# "stable" has the Alpine meaning (linux-lts and linux-stable). This is the
# newest upstream stable series (now 7.2.x). We rebase it on each new release,
# because a stable series reaches EOL soon after the next one ships. The LTS
# flavor (tsx-xx60-kernel-lts) is the default and lives longer. Use this
# flavor if you want the newest driver fixes sooner. Both flavors install
# side by side, each with its own /lib/modules/<release>/ and its own
# /boot/tsxboot-emmc-<flavor>.img. Only the image of the SELECTED flavor goes
# into the eMMC boot partition (tsx-kernel-flavor, tsx-xx60-boot-tools).
pkgname=tsx-xx60-kernel-stable
pkgver=7.2.8_git20261006
pkgrel=0
_kernelrelease=7.2.8-00119-geddf71e798ef
# The tsx-xx60-linux release tag whose "kbundle" CI asset this package pins.
# release.yml of that repo builds the asset when the tag is pushed. The tag
# builds the kernel of its kernel/KERNEL_REV.stable.
_kbundle_tag=v0.2.1
pkgdesc="xx60 mainline kernel, latest stable line"
url="https://github.com/tsx-mainline/tsx-xx60-linux"
arch="armv7"
license="GPL-2.0-only"
depends="tsx-xx60-boot-tools>=1-r4"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade"
source="https://github.com/tsx-mainline/tsx-xx60-linux/releases/download/$_kbundle_tag/tsx-xx60-kernel-stable-bundle.tar.zst"

package() {
	install -Dm644 "$srcdir"/tsxboot-emmc.img "$pkgdir"/boot/tsxboot-emmc-stable.img
	mkdir -p "$pkgdir"/usr/share/tsx
	echo "$_kernelrelease" > "$pkgdir"/usr/share/tsx/kernel-stable.release
	mkdir -p "$pkgdir"/lib/modules
	tar -xzf "$srcdir"/modules-$_kernelrelease.tar.gz -C "$pkgdir"
	# The bundle keeps the owner and the modes of the machine that packed it
	# (the CI runner).
	chown -R 0:0 "$pkgdir"/lib
	chmod -R go-w "$pkgdir"/lib
	# The build/source links of modules_install point into the kernel build
	# directory of the build machine. They have no meaning on a panel, and
	# they name paths on that machine.
	rm -f "$pkgdir"/lib/modules/$_kernelrelease/build "$pkgdir"/lib/modules/$_kernelrelease/source
}

sha512sums="
6023f48183655a466a6a9fe01640937c2d5bd9bb7101480601dce6ef7aad6ccb814315c363b40dc0ee28b72ab39ab17716897cf3fb903bb8812cee4f395572e7  tsx-xx60-kernel-stable-bundle.tar.zst
"
