#!/bin/sh
# Writes the boot image only on an installed xx60 panel whose selected flavor
# is stable (see tsx-kernel-flavor in tsx-xx60-boot-tools); anywhere else (a
# chroot, a container, the other flavor selected) it only reports.
if [ -x /usr/sbin/tsx-kernel-flavor ]; then
	/usr/sbin/tsx-kernel-flavor --hook stable
else
	echo "tsx-xx60-kernel-stable: tsx-kernel-flavor missing (tsx-xx60-boot-tools too old?); nothing written"
fi
exit 0
