#!/bin/sh
# Write the boot image only on an installed xx60 panel where the selected
# flavor is stable (see tsx-kernel-flavor in tsx-xx60-boot-tools). In all other
# cases (a chroot, a container, or the other flavor selected), only report.
if [ -x /usr/sbin/tsx-kernel-flavor ]; then
	/usr/sbin/tsx-kernel-flavor --hook stable
else
	echo "tsx-xx60-kernel-stable: tsx-kernel-flavor missing (tsx-xx60-boot-tools too old?); nothing written"
fi
exit 0
