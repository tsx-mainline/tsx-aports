# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Shared boot-image tooling for the xx60 platform: tsx-update-boot (vendored
# from tsx-xx60-linux installer/emmc/tsx-update-boot, same script the
# installer uses), tsx-kernel-flavor (show/switch the booted kernel flavor;
# also the tsx-xx60-kernel-* install/upgrade hook) and the
# tsx_is_installed_panel() detection helper. A separate package so both
# kernel flavors (installable side by side) share one copy.
pkgname=tsx-xx60-boot-tools
pkgver=1
pkgrel=5
pkgdesc="xx60 eMMC/card boot image update tools"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7"
license="GPL-2.0-or-later"
depends="busybox"
options="!check"
source="tsx-update-boot tsx-is-panel.sh tsx-kernel-flavor"

package() {
	install -Dm755 "$srcdir"/tsx-update-boot "$pkgdir"/usr/sbin/tsx-update-boot
	install -Dm644 "$srcdir"/tsx-is-panel.sh "$pkgdir"/usr/lib/tsx/tsx-is-panel.sh
	install -Dm755 "$srcdir"/tsx-kernel-flavor "$pkgdir"/usr/sbin/tsx-kernel-flavor
}

sha512sums="
