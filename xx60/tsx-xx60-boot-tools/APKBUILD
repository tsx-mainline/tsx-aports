# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Shared boot-image tools for the xx60 platform:
#   - tsx-update-boot, vendored from installer/emmc/tsx-update-boot in
#     tsx-xx60-linux. It is the same script as the installer uses.
#   - tsx-kernel-flavor, which shows or switches the booted kernel flavor.
#     It is also the install and upgrade hook of the tsx-xx60-kernel-*
#     packages.
#   - The tsx_is_installed_panel() detection helper.
# This is a separate package, so that both kernel flavors (which install side
# by side) share one copy.
pkgname=tsx-xx60-boot-tools
pkgver=1
pkgrel=6
pkgdesc="xx60 eMMC/card boot image update tools"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7"
license="GPL-2.0-or-later"
depends="busybox"
options="!check"
source="tsx-update-boot tsx-is-panel.sh tsx-kernel-flavor"

package() {
	install -Dm755 "$srcdir"/tsx-update-boot "$pkgdir"/usr/sbin/tsx-update-boot
	install -Dm644 "$srcdir"/tsx-is-panel.sh "$pkgdir"/usr/lib/tsx/tsx-is-panel.sh
	install -Dm755 "$srcdir"/tsx-kernel-flavor "$pkgdir"/usr/sbin/tsx-kernel-flavor
}

sha512sums="
