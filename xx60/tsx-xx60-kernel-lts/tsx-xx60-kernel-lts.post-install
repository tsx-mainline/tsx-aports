#!/bin/sh
# ONLY writes anything on an installed xx60 panel (see tsx_is_installed_panel
# in tsx-xx60-boot-tools): elsewhere (a plain `apk add` test in a chroot or
# a docker --platform linux/arm/v7 container) this just reports that and exits.
. /usr/lib/tsx/tsx-is-panel.sh 2>/dev/null || {
	echo "tsx-xx60-kernel-lts: tsx-is-panel.sh helper missing (tsx-xx60-boot-tools not installed?); nothing written"
	exit 0
}
if tsx_is_installed_panel; then
	IMG=/boot/tsxboot-emmc.img
	SHA=$(sha256sum < "$IMG" | cut -d' ' -f1)
	echo "tsx-xx60-kernel-lts: writing the new boot image into the eMMC boot partition"
	if /usr/sbin/tsx-update-boot --emmc "$IMG" "$SHA"; then
		echo "tsx-xx60-kernel-lts: reboot to use the new kernel"
	else
		echo "tsx-xx60-kernel-lts: tsx-update-boot failed; the panel still boots the previous kernel"
	fi
else
	echo "tsx-xx60-kernel-lts: not on an installed xx60 panel (or running in a chroot/container); nothing written"
fi
exit 0
