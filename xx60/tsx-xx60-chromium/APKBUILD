# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Third-party software (Chromium). It keeps its own upstream license (see
# license= below), not GPL-2.0-or-later. The files patch-chromium.py and
# sigs.json in this directory are our own work under GPL-2.0-or-later (see
# ../../LICENSE).
#
# This is NOT a source build, because a from-source Chromium build takes hours.
# The recipe repackages the armv7 chromium .apk of Alpine v3.24 and patches
# it at the byte level. The patch changes the 2-byte ES3->ES2 EGL context
# fallback gate (see patch-chromium.py and sigs.json, which come from
# rootfs/src/chromium-es2/ in tsx-xx60-linux, with the same tool and the same
# signature list). With the patch, the GPU process of Chromium falls back to
# GLES2 on the Mali-450 (lima, GLES2 only) and does not abort the GPU init.
# The build then republishes the result, signed with the project key.
# If the build does not find the patch site (unknown sha256), or its bytes do
# not match the recorded instruction pattern, the build FAILS and publishes
# nothing. See the scheduled "chromium watch" job in
# ../../.github/workflows/build.yml. See also
# rootfs/src/chromium-es2/README.md ("Re-deriving for a new Chromium
# package") for the steps when Alpine ships a new Chromium build.
#
# provides=chromium=<same version> makes `apk add chromium` resolve to this
# package when this repo is listed. With apk, a real pkgname match and a
# provides= virtual match of the same name and version are both eligible.
# The repository order decides which one the solver picks. See README.md
# "Which chromium wins" for the order in the install instructions of this
# repo, and for how we verified it. replaces=chromium lets this package take
# over the files of a machine that already has the real "chromium" package,
# without a conflict.
#
# depends= is a VERBATIM copy of the .PKGINFO of the real
# chromium-152.0.7977.82-r0 package. It includes plain dependencies and so:
# soname dependencies. We ship the identical binaries (except 2 patched
# bytes), so the dependency set is the same as ours. A copy is more correct
# than a new derivation. The automatic ELF and soname scan of abuild
# (options="tracedeps", the default) would need every one of these so:
# libraries in the build container, to resolve names to package versions.
# Our makedepends does not install them (for example, nothing here needs
# libFLAC at build time). !tracedeps turns the scan off. If you change
# package() so that the shipped binaries change, derive the list again from
# the .PKGINFO of the new .apk (`tar -xzf chromium-*.apk .PKGINFO && cat
# .PKGINFO`). Do not edit it by hand.
pkgname=tsx-xx60-chromium
pkgver=152.0.7977.82
pkgrel=0
pkgdesc="Chromium web browser, repackaged with the Mali-450 ES2 fallback patch"
url="https://www.chromium.org/Home"
arch="armv7"
license="BSD-3-Clause"
depends="
	chromium-common=$pkgver-r$pkgrel
	font-opensans
	gtk+3.0
	icu-data-full
	mesa-dri-gallium
	musl>=1.2.3_git20230322-r0
	xdg-utils
	so:libFLAC.so.12
	so:libX11.so.6
	so:libXcomposite.so.1
	so:libXdamage.so.1
	so:libXext.so.6
	so:libXfixes.so.3
	so:libXi.so.6
	so:libXrandr.so.2
	so:libXrender.so.1
	so:libXtst.so.6
	so:libasound.so.2
	so:libatk-1.0.so.0
	so:libatk-bridge-2.0.so.0
	so:libatspi.so.0
	so:libavcodec.so.62
	so:libavformat.so.62
	so:libavutil.so.60
	so:libbrotlidec.so.1
	so:libbrotlienc.so.1
	so:libc.musl-armv7.so.1
	so:libcairo.so.2
	so:libcrc32c.so.1
	so:libcups.so.2
	so:libdav1d.so.7
	so:libdbus-1.so.3
	so:libdouble-conversion.so.3
	so:libdrm.so.2
	so:libexpat.so.1
	so:libffi.so.8
	so:libfontconfig.so.1
	so:libfreetype.so.6
	so:libgbm.so.1
	so:libgcc_s.so.1
	so:libgio-2.0.so.0
	so:libglib-2.0.so.0
	so:libgmodule-2.0.so.0
	so:libgobject-2.0.so.0
	so:libharfbuzz-subset.so.0
	so:libharfbuzz.so.0
	so:libintl.so.8
	so:libjpeg.so.8
	so:libminizip.so.1
	so:libnspr4.so
	so:libnss3.so
	so:libnssutil3.so
	so:libopenh264.so.8
	so:libopus.so.0
	so:libpango-1.0.so.0
	so:libpipewire-0.3.so.0
	so:libplc4.so
	so:libplds4.so
	so:libpulse.so.0
	so:libsmime3.so
	so:libstdc++.so.6
	so:libudev.so.1
	so:libwebp.so.7
	so:libwebpdemux.so.2
	so:libwebpmux.so.3
	so:libxcb.so.1
	so:libxkbcommon.so.0
	so:libxml2.so.2
	so:libxslt.so.1
	so:libz.so.1
	so:libzstd.so.1
	"
makedepends="python3"
provides="chromium=$pkgver-r$pkgrel cmd:chromium=$pkgver-r$pkgrel cmd:chromium-browser=$pkgver-r$pkgrel"
replaces="chromium"
# suid: usr/lib/chromium/chrome-sandbox is a setuid root binary on purpose,
# like in the chromium package of Alpine. It drops its privileges again after
# it sets up the sandbox. Without this option, the postcheck of abuild
# refuses to package a setuid binary. !tracedeps: see the depends= comment
# above.
options="net suid !tracedeps"
source="chromium-$pkgver-r$pkgrel.apk::https://dl-cdn.alpinelinux.org/alpine/v3.24/community/armv7/chromium-$pkgver-r$pkgrel.apk
	patch-chromium.py
	sigs.json"

build() {
	rm -rf extract
	mkdir -p extract
	# An .apk is a concatenation of gzip members (signature, control, data).
	# A plain tar -xzf reads all of them. Remove the control metadata files
	# that it also extracts.
	tar -xzf "$srcdir"/chromium-$pkgver-r$pkgrel.apk -C extract
	rm -f extract/.PKGINFO extract/.SIGN.RSA.*

	BIN=extract/usr/lib/chromium/chromium
	[ -f "$BIN" ] || { echo "tsx-xx60-chromium: $BIN not found; Alpine's chromium package layout changed" >&2; exit 1; }

	rc=0; python3 "$srcdir"/patch-chromium.py --check "$BIN" || rc=$?
	[ "$rc" = 1 ] || { echo "tsx-xx60-chromium: $BIN is not a fresh, known, unpatched build (--check exit $rc); refusing to publish" >&2; exit 1; }

	mkdir -p extract/etc/tsx
	python3 "$srcdir"/patch-chromium.py --sidecar extract/etc/tsx/chromium-es2-patched \
		--target-path /usr/lib/chromium/chromium "$BIN"

	python3 "$srcdir"/patch-chromium.py --check "$BIN" || {
		echo "tsx-xx60-chromium: patch verification failed after patching; refusing to publish" >&2; exit 1; }
}

package() {
	mkdir -p "$pkgdir"
	cp -a extract/. "$pkgdir"/
}

sha512sums="
