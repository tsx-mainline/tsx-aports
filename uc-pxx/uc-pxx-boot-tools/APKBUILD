# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# The A/B boot control of the uc-pxx panels (UC-P10, UC-P8): the reviewed
# program uc-pxx-bootctl, the boot-marking hook uc-pxx-mark-boot.sh and its
# service uc-pxx-boot-ok, the flash wrapper uc-pxx-flash-boot, the helper
# uc-pxx-arm-slot, uc-pxx-reboot (the loader and fastboot modes, a script
# with the program uc-pxx-reboot-syscall), uc-pxx-update-boot (puts
# the boot image of uc-pxx-kernel-lts into boot_a through the two wrappers)
# and uc-pxx-post-update (the board step of tsx-autoupdate after an install:
# it checks the reviewed files, arms slot A, runs uc-pxx-update-boot write
# --yes and checks the A/B state before a restart).
# 0.1.0-r2: the first public build (r1 was a private build).
# 0.1.1-r0: the service uc-pxx-boot-ok stays "started" after the hook ends
# (no "crashed" in rc-status). The source is the tag board-v0.1.1.
# 0.2.0-r0: the both-slot boot control (uc-pxx-linux mainline-linux-int,
# MAINLINE-STEP2-DESIGN section 10 L1-L5). New: uc-pxx-slot (prints the slot
# that U-Boot started; in boot-control.sha256). The hook marks the booted
# slot (mark-successful --expect a|b); uc-pxx-bootctl (source c4368f09...)
# checks the token of boot_b for --expect b; uc-pxx-arm-slot and
# uc-pxx-flash-boot change nothing unless slot A runs (or a RAM boot) with
# the root system_a. uc-pxx-update-boot, uc-pxx-post-update and
# uc-pxx-boot-ok are unchanged. Ship it only with uc-pxx-board 0.2.0 and the
# both-slot kernel package (the depends of uc-pxx-board). The pins below are
# NOT yet reviewed for the safety rules: the owner enters them after their
# review (BOTH-SLOT-PACKAGING-2026-11-10.md). The source is the tag
# board-v0.2.0 (not yet made: a local build uses a snapshot, README.md).
#
# PINNED FILES. Five files of this package may write the A/B metadata (misc LBA
# 49156) of a panel, and two more run them without a person
# (uc-pxx-update-boot, uc-pxx-post-update). An independent review approved their exact bytes (the
# sha256 values in _pins). The eighth, uc-pxx-slot (0.2.0), only reads: it
# names the booted slot for the hook. check() refuses the build when a source file has
# another sha256, and package() checks the installed copies again. Never
# change a value in _pins without a new review of that exact file. The
# binary is the reviewed static build, so this recipe does not compile it,
# and options has !strip: abuild must not change its bytes.
#
# Sources:
#  - the GitHub archive of the tag board-v$pkgver of uc-pxx-linux (the five
#    scripts of rootfs/overlay)
#  - uc-pxx-tools-bundle.tar.zst, an asset of the tsx-aports release
#    _tbundle_tag (uc-pxx-bootctl, uc-pxx-reboot-syscall and rtl8363-init, built on
#    the build host, see scripts/stage-uc-pxx-tools.sh)
#  - uc-pxx-update-boot next to this file
# The sums at the end are those of the tag archive and of the tools bundle; they
# need the real files (all zeros for 0.2.0 until the tag and the release
# exist). A local build uses the files in dist/ (SRCDEST):
# scripts/uc-pxx-source.sh writes a snapshot of a commit under the name of the
# tag archive, and scripts/stage-uc-pxx-tools.sh writes the bundle. Then
# run abuild checksum (README.md "uc-pxx packages"). Do not commit the sums of a
# local snapshot.
SRCDEST="$startdir/dist"
pkgname=uc-pxx-boot-tools
pkgver=0.2.0
pkgrel=0
_tbundle_tag=uc-pxx-tools-20261110
pkgdesc="uc-pxx A/B boot control (both slots): uc-pxx-bootctl, uc-pxx-slot, the boot-marking hook, the flash wrapper and uc-pxx-update-boot"
url="https://github.com/tsx-mainline/uc-pxx-linux"
arch="aarch64"
license="GPL-2.0-or-later"
depends="busybox openrc python3"
options="!strip"
source="uc-pxx-linux-$pkgver.tar.gz::https://github.com/tsx-mainline/uc-pxx-linux/archive/refs/tags/board-v$pkgver.tar.gz
	https://github.com/tsx-mainline/tsx-aports/releases/download/$_tbundle_tag/uc-pxx-tools-bundle.tar.zst
	uc-pxx-update-boot
	"
builddir="$srcdir/uc-pxx-linux-board-v$pkgver"

# sha256, the file in the sources (bundle: the tools bundle, tag: the tag
# archive), the path in the package. The values are the reviewed files of the
# uc-pxx boot control (rule 9 exception of the UC-P10 safety rules).
# uc-pxx-update-boot is a caller of the two wrappers. Its sha256 is the one
# that the review passed (GO in round 2, plan/uc-pxx/UPDATE-BOOT-REVIEW.md),
# and it is in the rule 9 list. A changed copy needs a new review.
# uc-pxx-post-update is the board step of tsx-autoupdate (POST-UPDATE-REVIEW,
# round 3). It is in boot-control.sha256 too, so its own sha256sum -c also
# checks itself.
# uc-pxx-slot decides the slot for the hook (and, as its own copy, for the
# initramfs): it is in boot-control.sha256 (MAINLINE-STEP2-DESIGN review F10).
# uc-pxx-arm-slot and uc-pxx-flash-boot parse the slot themselves (they do
# not run it).
# scripts/check-apk-pins.sh checks the same list in the built .apk.
_pins="
11c2afcd0272f9c989f9825074186a2341d0a33a34e0fe9ebf92cf0081f9efa7 bundle:uc-pxx-bootctl usr/sbin/uc-pxx-bootctl
fe581cf2212d8bc01ff54d1b88dc7d03601af075f56e74fb0d3edf2553a08056 tag:rootfs/overlay/etc/uc-pxx-mark-boot.sh etc/uc-pxx-mark-boot.sh
15d7588c6f6dd9bea3bb8fbccf4e4d4c8986c7e20973f806c71ba530e78f59f4 tag:rootfs/overlay/etc/init.d/uc-pxx-boot-ok etc/init.d/uc-pxx-boot-ok
2fad02b3d825706affabac71c45a2a04d2143970dcf014c1586593c11dfd6fee tag:rootfs/overlay/usr/sbin/uc-pxx-flash-boot usr/sbin/uc-pxx-flash-boot
26c3f1c0a375674f8a80b2536ed6765f85ae6b13724770767039a271650f786e tag:rootfs/overlay/usr/sbin/uc-pxx-arm-slot usr/sbin/uc-pxx-arm-slot
4de04b78b8a48a4cf4d79f22f18f2f69a6932a36398e4ba6ec0ac175483b3703 local:uc-pxx-update-boot usr/sbin/uc-pxx-update-boot
a512a311af2ddfa8a08be74cb19c7aebee8d4de773f59e5c98885dc3924836f3 tag:rootfs/overlay/usr/sbin/uc-pxx-post-update usr/sbin/uc-pxx-post-update
cfec605c6d4042b36aa9882efa3bf8ee1f5a186ad3a06b07a7cc351b796abe2e tag:rootfs/overlay/usr/sbin/uc-pxx-slot usr/sbin/uc-pxx-slot
"

# _check_pins source|package: every pinned file has its reviewed sha256.
_check_pins() {
	local sum src dst f got bad=0
	while read -r sum src dst; do
		[ -n "$sum" ] || continue
		case $1:$src in
		source:bundle:*) f=$srcdir/${src#bundle:};;
		source:tag:*) f=$builddir/${src#tag:};;
		source:local:*) f=$srcdir/${src#local:};;
		package:*) f=$pkgdir/$dst;;
		*) error "bad pin line: $sum $src $dst"; return 1;;
		esac
		got=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)
		if [ "$got" = "$sum" ]; then
			msg "pinned file OK: /$dst $sum"
		else
			error "pinned file CHANGED: $f has sha256 '$got', the reviewed file has $sum"
			bad=1
		fi
	done <<-EOF
	$_pins
	EOF
	return $bad
}

prepare() {
	default_prepare
	# the bundle has its own list of sums
	(cd "$srcdir" && sha256sum -c CHECKSUMS.sha256) || { error "the tools bundle does not match its CHECKSUMS.sha256"; return 1; }
}

check() {
	_check_pins source
}

package() {
	local o=$builddir/rootfs/overlay
	install -Dm755 "$srcdir"/uc-pxx-bootctl "$pkgdir"/usr/sbin/uc-pxx-bootctl
	install -Dm755 "$o"/etc/uc-pxx-mark-boot.sh "$pkgdir"/etc/uc-pxx-mark-boot.sh
	install -Dm755 "$o"/etc/init.d/uc-pxx-boot-ok "$pkgdir"/etc/init.d/uc-pxx-boot-ok
	install -Dm755 "$o"/usr/sbin/uc-pxx-flash-boot "$pkgdir"/usr/sbin/uc-pxx-flash-boot
	install -Dm755 "$o"/usr/sbin/uc-pxx-arm-slot "$pkgdir"/usr/sbin/uc-pxx-arm-slot
	# the booted slot (a or b) from the U-Boot command line, read only
	install -Dm755 "$o"/usr/sbin/uc-pxx-slot "$pkgdir"/usr/sbin/uc-pxx-slot
	# uc-pxx-reboot stops the system with init, then the program restarts it
	# with the mode argument (reboot(2) with RESTART2).
	install -Dm755 "$o"/usr/sbin/uc-pxx-reboot "$pkgdir"/usr/sbin/uc-pxx-reboot
	install -Dm755 "$srcdir"/uc-pxx-reboot-syscall "$pkgdir"/usr/libexec/uc-pxx-reboot-syscall
	install -Dm755 "$srcdir"/uc-pxx-update-boot "$pkgdir"/usr/sbin/uc-pxx-update-boot
	# The board step of tsx-autoupdate after an install (tsx_board_post_update
	# of uc-pxx-board runs it).
	install -Dm755 "$o"/usr/sbin/uc-pxx-post-update "$pkgdir"/usr/sbin/uc-pxx-post-update
	# The list of the reviewed files, for a check on the panel:
	#   sha256sum -c /usr/share/uc-pxx/boot-control.sha256
	mkdir -p "$pkgdir"/usr/share/uc-pxx
	echo "$_pins" | awk 'NF == 3 { print $1 "  /" $3 }' > "$pkgdir"/usr/share/uc-pxx/boot-control.sha256
	_check_pins package
}

sha512sums="
