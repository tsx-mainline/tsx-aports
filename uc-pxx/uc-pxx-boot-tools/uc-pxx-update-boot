#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
"""uc-pxx-update-boot: put the boot image of the kernel package into boot_a.

The kernel package (uc-pxx-kernel-lts) ships /boot/uc-pxx-lts.img without the
Rockchip resource for U-Boot. The resource derives from vendor files, so no
package holds it. This tool takes the resource from the "second" part of the
stock boot image in boot_b of this unit, puts it into a copy of the package
image, and writes the copy into boot_a only through the reviewed wrappers:
first uc-pxx-arm-slot, then uc-pxx-flash-boot IMAGE SHA256. The tool itself
opens every block device read only.

The resource must be one that has booted on that model. RESOURCES lists their
sha256 values. The tool refuses every other resource, and it has no option to
skip this check: a new resource needs a new review and a new entry.

  uc-pxx-update-boot [status]       show the package image, boot_a and boot_b.
                                    Read only.
  uc-pxx-update-boot check          make the image in /run/uc-pxx and check it.
                                    The eMMC is only read.
  uc-pxx-update-boot write [--yes]  make and check the image, show the checks,
                                    then run uc-pxx-arm-slot and
                                    uc-pxx-flash-boot. Without --yes it asks on
                                    the terminal. Reboot after it to start the
                                    new kernel.
  uc-pxx-update-boot --hook         the install and upgrade scripts of the
                                    kernel package: report only, never write.
  uc-pxx-update-boot assemble TEMPLATE RESOURCE OUT
                                    no device access: put RESOURCE into the
                                    package image TEMPLATE (for an installer
                                    on a host). OUT must not exist.
  uc-pxx-update-boot extract BOOTIMG OUT
                                    no device access: write the second part
                                    (the resource) of the boot image file
                                    BOOTIMG to OUT. OUT must not exist.
  uc-pxx-update-boot inspect IMAGE  no device access: check a package image
                                    (no resource) and show its token, model
                                    and kernel release.

Exit status:
   0  done, or nothing to do
   1  refused before uc-pxx-arm-slot ran: nothing was armed or written
   2  usage
  1N  uc-pxx-arm-slot exited with N (11: refused or failed, 13: the A/B state
      is unknown). boot_a was not written. Slot A may be armed (trying).
  2N  uc-pxx-flash-boot exited with N. Slot A was armed (trying). boot_a may
      hold a partial or an old image (21), or the A/B state needs a person
      (23, 24). Read the message of the wrapper before a reboot. 29: the
      wrapper could not start, boot_a was not written.
  30  a wrapper was ended by a signal. Slot A may be trying and boot_a may be
      partial. Do not reboot before uc-pxx-bootctl status is checked.

Test hooks (environment, ignored when the tool runs as root): UC_PXX_SYSBLOCK,
UC_PXX_DEVDIR, UC_PXX_ROOT, UC_PXX_DT_COMPATIBLE, UC_PXX_RUNDIR,
UC_PXX_BOOT_IMAGE, UC_PXX_RELEASE_FILE, UC_PXX_ARM_SLOT, UC_PXX_FLASH_BOOT,
UC_PXX_BOOTCTL, UC_PXX_TEST_NONROOT.
"""
import errno
import fcntl
import hashlib
import os
import re
import signal
import stat
import struct
import subprocess
import sys
import tempfile

IS_ROOT = os.geteuid() == 0


def setting(name, default):
    """A path of the panel. Root always gets the fixed path: no environment
    variable can change what root reads, writes or runs."""
    if IS_ROOT:
        return default
    return os.environ.get(name, default)


SYSBLOCK = setting("UC_PXX_SYSBLOCK", "/sys/class/block")
DEVDIR = setting("UC_PXX_DEVDIR", "/dev")
ROOT = setting("UC_PXX_ROOT", "/")
DT_COMPATIBLE = setting("UC_PXX_DT_COMPATIBLE", "/proc/device-tree/compatible")
RUNDIR = setting("UC_PXX_RUNDIR", "/run/uc-pxx")
BOOT_IMAGE = setting("UC_PXX_BOOT_IMAGE", "/boot/uc-pxx-lts.img")
RELEASE_FILE = setting("UC_PXX_RELEASE_FILE", "/usr/share/uc-pxx/kernel-lts.release")
ARM_SLOT = setting("UC_PXX_ARM_SLOT", "/usr/sbin/uc-pxx-arm-slot")
FLASH_BOOT = setting("UC_PXX_FLASH_BOOT", "/usr/sbin/uc-pxx-flash-boot")
BOOTCTL = setting("UC_PXX_BOOTCTL", "/usr/sbin/uc-pxx-bootctl")
TEST_NONROOT = (not IS_ROOT) and bool(os.environ.get("UC_PXX_TEST_NONROOT"))

MAGIC = b"ANDROID!"
# uc-pxx-flash-boot and kernel/mkimage.sh of uc-pxx-linux refuse a larger image
# (the boot descriptor of vbmeta_a, docs/boot.md "Size limits").
MAX_IMAGE = 64 * 1024 * 1024
MAX_RESOURCE = 16 * 1024 * 1024
# The image of kernel/mkimage.sh: header version 0, page size 2048. The shim
# has the device tree at 64 KiB and the Linux Image at 2 MiB.
PAGE = 2048
SHIM_DTB = 0x10000
SHIM_LINUX = 0x200000
MODELS = ("crestron,uc-p10", "crestron,uc-p8")
TOKEN_RE = re.compile(r"^[A-Za-z0-9._-]{1,15}$")
# The resources (sha256 of the whole second part) that booted on each model
# with its vendor U-Boot. UC-P10: the stock resource of boot_b, in boot_a of
# the v4 image (UC-P10 safety rules, rule 9). UC-P8: none yet, so a UC-P8 is
# refused. Never add a value without a review and a boot test on that model.
RESOURCES = {
    "crestron,uc-p10": ("290ef40577d434d702c3544076dbebd6ddd17e16087eff0e84c92549d67bb363",),
    "crestron,uc-p8": (),
}
SIGNALS = (signal.SIGINT, signal.SIGHUP, signal.SIGTERM, signal.SIGQUIT)


class Refuse(Exception):
    """A check failed. Nothing was armed or written."""


_quiet = False


def say(msg):
    """Print a line. A closed stdout (a pipe to head, a lost terminal) does not
    stop the tool: the output goes away and the work goes on."""
    global _quiet
    if _quiet:
        return
    try:
        sys.stdout.write("uc-pxx-update-boot: " + msg + "\n")
        sys.stdout.flush()
    except OSError:
        _quiet = True
        try:
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass


# --- the Android boot image header (versions 0 to 2) -------------------------

def pages(n, page):
    return (n + page - 1) // page


def parse_header(head):
    """Return a dict of the header fields of an Android boot image."""
    if len(head) < 1660 or head[:8] != MAGIC:
        raise Refuse("no Android boot image (no ANDROID! magic)")
    f = struct.unpack_from("<8s10I16s512s32s", head, 0)
    h = dict(kernel_size=f[1], ramdisk_size=f[3], second_size=f[5], page=f[8],
             version=f[9], name=f[11].rstrip(b"\0"), id=f[13], dtbo_size=0, dtb_size=0)
    if h["version"] > 2:
        raise Refuse("boot image header version %d (only 0 to 2 are known)" % h["version"])
    if h["page"] not in (2048, 4096):
        raise Refuse("boot image page size %d" % h["page"])
    if h["version"] >= 1:
        h["dtbo_size"] = struct.unpack_from("<I", head, 1632)[0]
    if h["version"] >= 2:
        h["dtb_size"] = struct.unpack_from("<I", head, 1648)[0]
    p = h["page"]
    h["kernel_off"] = p
    h["ramdisk_off"] = p * (1 + pages(h["kernel_size"], p))
    h["second_off"] = h["ramdisk_off"] + p * pages(h["ramdisk_size"], p)
    h["dtbo_off"] = h["second_off"] + p * pages(h["second_size"], p)
    h["dtb_off"] = h["dtbo_off"] + p * pages(h["dtbo_size"], p)
    h["end"] = h["dtb_off"] + p * pages(h["dtb_size"], p)
    return h


def image_id(h, read):
    """The id field that mkbootimg writes: sha1 over each part and its size."""
    s = hashlib.sha1()
    parts = [("kernel_off", "kernel_size"), ("ramdisk_off", "ramdisk_size"), ("second_off", "second_size")]
    if h["version"] >= 1:
        parts.append(("dtbo_off", "dtbo_size"))
    if h["version"] >= 2:
        parts.append(("dtb_off", "dtb_size"))
    for off, size in parts:
        s.update(read(h[off], h[size]))
        s.update(struct.pack("<I", h[size]))
    return s.digest().ljust(32, b"\0")


def check_resource(res):
    """Check the layout of a Rockchip resource (RSCE). Return its entry names."""
    if len(res) < 1024 or res[:4] != b"RSCE":
        raise Refuse("the resource does not start with RSCE")
    # struct resource_img_hdr of the Rockchip U-Boot: magic, two u16 versions,
    # three u8 (header, table offset and entry size in 512-byte blocks), one
    # pad byte, u32 entry count at byte 12 (as in the stock resource).
    hdr_blks, tbl_blks, ent_blks = struct.unpack_from("<BBB", res, 8)
    count = struct.unpack_from("<I", res, 12)[0]
    if not (1 <= ent_blks <= 4 and 1 <= count <= 64 and tbl_blks >= 1):
        raise Refuse("the resource header is not plausible (%d entries)" % count)
    names = []
    for i in range(count):
        e = (tbl_blks + i * ent_blks) * 512
        if e + 512 > len(res) or res[e:e + 4] != b"ENTR":
            raise Refuse("resource entry %d is missing" % i)
        name = res[e + 4:e + 260].split(b"\0", 1)[0].decode("ascii", "replace")
        off, size = struct.unpack_from("<II", res, e + 260)
        if off * 512 + size > len(res):
            raise Refuse("resource entry %s ends after the resource" % name)
        names.append(name)
    if "rk-kernel.dtb" not in names:
        raise Refuse("the resource has no rk-kernel.dtb entry")
    return names


def check_allowed(res, model):
    """The resource must be one that booted on MODEL (RESOURCES). No override."""
    sha = hashlib.sha256(res).hexdigest()
    allowed = RESOURCES.get(model, ())
    if sha not in allowed:
        if not allowed:
            raise Refuse("no resource is approved for %s yet (this resource: sha256 %s)" % (model, sha))
        raise Refuse("the resource (sha256 %s) is not the approved resource of %s (%s)"
                     % (sha, model, " ".join(allowed)))
    return sha


# --- the device tree in the shim ----------------------------------------------

def fdt_props(dtb, path):
    """The properties of the node PATH ("/" or "/chosen") of a flat device tree."""
    if len(dtb) < 40 or dtb[:4] != b"\xd0\x0d\xfe\xed":
        raise Refuse("no device tree")
    total, off_struct, off_strings = struct.unpack_from(">III", dtb, 4)
    size_strings, size_struct = struct.unpack_from(">II", dtb, 32)
    if total > len(dtb) or off_struct + size_struct > total or off_strings + size_strings > total:
        raise Refuse("the device tree header is not plausible")
    want = [p for p in path.split("/") if p]
    stack, props, i, end = [], {}, off_struct, off_struct + size_struct
    while i + 4 <= end:
        tok = struct.unpack_from(">I", dtb, i)[0]
        i += 4
        if tok == 1:                                   # FDT_BEGIN_NODE
            j = dtb.index(b"\0", i)
            name = dtb[i:j].decode("ascii", "replace")
            stack.append(name)
            i = (j + 4) & ~3
        elif tok == 2:                                 # FDT_END_NODE
            if not stack:
                break
            stack.pop()
        elif tok == 3:                                 # FDT_PROP
            ln, nameoff = struct.unpack_from(">II", dtb, i)
            i += 8
            if [s for s in stack[1:]] == want:
                k = off_strings + nameoff
                pname = dtb[k:dtb.index(b"\0", k)].decode("ascii", "replace")
                props[pname] = dtb[i:i + ln]
            i = (i + ln + 3) & ~3
        elif tok == 4:                                 # FDT_NOP
            continue
        elif tok == 9:                                 # FDT_END
            break
        else:
            raise Refuse("the device tree has a bad token")
    return props


def shim_dtb(data, h):
    k = h["kernel_off"]
    dtb = data[k + SHIM_DTB:k + SHIM_LINUX]
    if dtb[:4] != b"\xd0\x0d\xfe\xed":
        raise Refuse("no device tree at 64 KiB in the kernel part of the package image")
    return dtb[:struct.unpack_from(">I", dtb, 4)[0]]


def dtb_model(data, h):
    """The crestron model of the device tree in the shim (64 KiB into the kernel part)."""
    comp = fdt_props(shim_dtb(data, h), "/").get("compatible", b"").split(b"\0")
    for m in MODELS:
        if m.encode() in comp:
            return m
    raise Refuse("the device tree of the package image names no UC-P model")


def dtb_token(data, h):
    """The token of the word uc-pxx.id= in /chosen/bootargs of the shim device tree."""
    args = fdt_props(shim_dtb(data, h), "/chosen").get("bootargs", b"").rstrip(b"\0").decode("ascii", "replace")
    ids = [w[len("uc-pxx.id="):] for w in args.split() if w.startswith("uc-pxx.id=")]
    return ids[0] if len(ids) == 1 else ""


def linux_release(data, h):
    k = h["kernel_off"] + SHIM_LINUX
    m = re.search(rb"Linux version (\S+)", data[k:k + h["kernel_size"] - SHIM_LINUX])
    return m.group(1).decode() if m else ""


# --- the package image (kernel/mkimage.sh with an empty resource) ------------

def check_template(data):
    """Check the boot image of the kernel package. Return its header."""
    h = parse_header(data[:4096])
    if h["version"] != 0 or h["page"] != PAGE:
        raise Refuse("the package image is not a header version 0 image with page size %d" % PAGE)
    if h["second_size"] != 0:
        raise Refuse("the package image already has a second part (%d bytes)" % h["second_size"])
    token = h["name"].decode("ascii", "replace")
    if not TOKEN_RE.match(token):
        raise Refuse("the package image has no build token in its header name field")
    if len(data) != h["end"]:
        raise Refuse("the package image has %d bytes, its header says %d" % (len(data), h["end"]))
    if image_id(h, lambda o, n: data[o:o + n]) != h["id"]:
        raise Refuse("the id field of the package image does not match its content")
    if h["kernel_size"] <= SHIM_LINUX:
        raise Refuse("the kernel part of the package image is too small for the shim")
    mkbootimg_base(data)
    got = dtb_token(data, h)
    if got != token:
        raise Refuse("the kernel command line of the package image has uc-pxx.id=%s, the header has %s"
                     % (got or "(none)", token))
    return h


def mkbootimg_base(data):
    """The base address of an image that mkbootimg made with its default offsets."""
    kernel_addr, _, ramdisk_addr, _, _, tags_addr = struct.unpack_from("<6I", data, 12)
    base = kernel_addr - 0x00008000
    if ramdisk_addr != base + 0x01000000 or tags_addr != base + 0x00000100:
        raise Refuse("the package image does not have the default load addresses of mkbootimg")
    return base


def assemble(data, h, res):
    """The package image with RES as the second part, as mkbootimg makes it."""
    out = bytearray(data[:h["second_off"]])
    struct.pack_into("<I", out, 24, len(res))
    # mkbootimg writes second_addr only when the second part is not empty
    struct.pack_into("<I", out, 28, mkbootimg_base(data) + 0x00f00000)
    out += res + b"\0" * ((-len(res)) % PAGE)
    n = parse_header(bytes(out[:4096]))
    struct.pack_into("32s", out, 576, image_id(n, lambda o, s: bytes(out[o:o + s])))
    return bytes(out)


def check_assembled(img, model):
    """Check the new image again from its own bytes: layout, id, size, token and
    the approved resource. This is the image that goes to uc-pxx-flash-boot."""
    n = parse_header(img[:4096])
    if n["version"] != 0 or n["page"] != PAGE or len(img) != n["end"]:
        raise Refuse("the new image has the wrong layout")
    if image_id(n, lambda o, s: img[o:o + s]) != n["id"]:
        raise Refuse("the id field of the new image does not match its content")
    if len(img) > MAX_IMAGE:
        raise Refuse("the new image has %d bytes, more than 64 MiB" % len(img))
    if dtb_token(img, n) != n["name"].decode("ascii", "replace"):
        raise Refuse("the token of the new image does not match its command line")
    check_allowed(img[n["second_off"]:n["second_off"] + n["second_size"]], model)
    return n


# --- the unit -----------------------------------------------------------------

def part_by_name(name):
    """(kernel name, sectors) of the eMMC partition with the GPT name NAME."""
    try:
        entries = sorted(os.listdir(SYSBLOCK))
    except OSError:
        return None
    for d in entries:
        if not re.match(r"^mmcblk\d+p\d+$", d):
            continue
        try:
            with open(os.path.join(SYSBLOCK, d, "uevent")) as f:
                if "PARTNAME=" + name not in f.read().splitlines():
                    continue
            with open(os.path.join(SYSBLOCK, d, "size")) as f:
                return d, int(f.read().strip())
        except (OSError, ValueError):
            continue
    return None


def read_dev(part, offset, size):
    """Read SIZE bytes at OFFSET of a partition. The device is opened read only."""
    fd = os.open(os.path.join(DEVDIR, part), os.O_RDONLY)
    try:
        os.lseek(fd, offset, os.SEEK_SET)
        buf = b""
        while len(buf) < size:
            chunk = os.read(fd, min(size - len(buf), 1 << 20))
            if not chunk:
                break
            buf += chunk
        return buf
    finally:
        os.close(fd)


def installed_panel():
    """None on an installed panel (/ is the partition system_a), else the reason."""
    if os.path.lexists(os.path.join(ROOT, ".dockerenv")):
        return "in a container"
    sys_a = part_by_name("system_a")
    if not sys_a:
        return "no eMMC partition named system_a"
    try:
        with open(os.path.join(SYSBLOCK, sys_a[0], "dev")) as f:
            maj, mnr = (int(x) for x in f.read().strip().split(":"))
        root = os.stat(ROOT).st_dev
    except (OSError, ValueError):
        return "cannot read the device numbers"
    # apk runs package scripts in their own mount namespace, so the test is the
    # device number of /, not /proc/1/root.
    if root != os.makedev(maj, mnr):
        return "/ is not system_a (a chroot, a rootfs build or the rescue system)"
    return None


def running_model():
    try:
        with open(DT_COMPATIBLE, "rb") as f:
            comp = f.read().split(b"\0")
    except OSError:
        return ""
    for m in MODELS:
        if m.encode() in comp:
            return m
    return ""


def boot_b_resource():
    """The second part of the boot image in boot_b. Return (bytes, entry names, header)."""
    p = part_by_name("boot_b")
    if not p:
        raise Refuse("no eMMC partition named boot_b")
    part, sectors = p
    h = parse_header(read_dev(part, 0, 4096))
    if h["end"] > sectors * 512:
        raise Refuse("the boot image in boot_b is larger than the partition")
    if not 0 < h["second_size"] <= MAX_RESOURCE:
        raise Refuse("the boot image in boot_b has no usable second part (%d bytes)" % h["second_size"])
    res = read_dev(part, h["second_off"], h["second_size"])
    if len(res) != h["second_size"]:
        raise Refuse("short read of the resource in boot_b")
    names = check_resource(res)
    return res, names, h


def boot_a_info():
    p = part_by_name("boot_a")
    if not p:
        raise Refuse("no eMMC partition named boot_a")
    head = read_dev(p[0], 0, 4096)
    token = ""
    if head[:8] == MAGIC:
        token = head[48:64].rstrip(b"\0").decode("ascii", "replace")
    return p, token


def boot_a_holds(p, img):
    got = read_dev(p[0], 0, len(img))
    return hashlib.sha256(got).hexdigest() == hashlib.sha256(img).hexdigest()


def load_template():
    try:
        with open(BOOT_IMAGE, "rb") as f:
            data = f.read()
    except OSError as e:
        raise Refuse("cannot read %s (is uc-pxx-kernel-lts installed?): %s" % (BOOT_IMAGE, e.strerror))
    h = check_template(data)
    return data, h


def package_release():
    try:
        with open(RELEASE_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


# --- the run folder -------------------------------------------------------------

def run_folder():
    """RUNDIR as a real folder of this user (root on a panel), mode 0700. Make
    it when it is missing. Refuse a link, another owner or another mode."""
    try:
        st = os.lstat(RUNDIR)
    except FileNotFoundError:
        os.mkdir(RUNDIR, 0o700)
        st = os.lstat(RUNDIR)
    if not stat.S_ISDIR(st.st_mode):
        raise Refuse("%s is not a folder (a link or a file)" % RUNDIR)
    if st.st_uid != os.geteuid():
        raise Refuse("%s belongs to uid %d, not to uid %d" % (RUNDIR, st.st_uid, os.geteuid()))
    if stat.S_IMODE(st.st_mode) != 0o700:
        raise Refuse("%s has mode %o, not 700" % (RUNDIR, stat.S_IMODE(st.st_mode)))
    return RUNDIR


def take_lock(folder):
    """One run at a time: a lock file in the run folder, without a wait."""
    fd = os.open(os.path.join(folder, "lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        os.close(fd)
        if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            raise Refuse("another uc-pxx-update-boot runs (%s/lock)" % folder)
        raise
    return fd


def clean_old_images(folder):
    """Remove the images of earlier runs (only names of this tool; a link is
    removed as a link, its target stays)."""
    for n in os.listdir(folder):
        if re.match(r"^(boot-assembled\.img(\.new)?|boot-[A-Za-z0-9_]+\.img)$", n):
            try:
                os.unlink(os.path.join(folder, n))
            except OSError:
                pass


def save_image(folder, img):
    """Write IMG to a new file with a unique name (O_EXCL, O_NOFOLLOW)."""
    fd, path = tempfile.mkstemp(prefix="boot-", suffix=".img", dir=folder)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(img)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        os.unlink(path)
        raise
    with open(path, "rb") as f:
        if hashlib.sha256(f.read()).hexdigest() != hashlib.sha256(img).hexdigest():
            os.unlink(path)
            raise Refuse("the image file in %s does not read back" % folder)
    return path


def create_out(out):
    """Open OUT for a new file only: no existing path, no link, not in /dev."""
    parent = os.path.realpath(os.path.dirname(os.path.abspath(out)))
    if parent == "/dev" or parent.startswith("/dev/"):
        raise Refuse("%s is in /dev" % out)
    if os.path.lexists(out):
        raise Refuse("%s exists (give a new file name)" % out)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    return os.fdopen(fd, "wb")


def safe_unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


def bootctl_status():
    try:
        r = subprocess.run([BOOTCTL, "status"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           universal_newlines=True, timeout=30)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return "uc-pxx-bootctl status failed: %s" % e


def run_wrapper(argv):
    """Run a wrapper in its own session and wait for it. The caller ignores the
    terminal signals, so neither a ^C nor a lost ssh session stops it, and this
    tool never kills it. Its output goes to stderr, and SIGPIPE stays ignored
    (restore_signals=False): a closed stdout of this tool (a pipe to head)
    cannot end the wrapper or a program that it runs."""
    p = subprocess.Popen(argv, start_new_session=True, restore_signals=False, stdout=2)
    while True:
        try:
            return p.wait()
        except InterruptedError:
            continue


# --- the commands -------------------------------------------------------------

def prepare():
    """Make and check the image in memory. Return the facts. Reads only."""
    why = installed_panel()
    if why:
        raise Refuse("not on an installed UC-P panel: " + why)
    data, h = load_template()
    token = h["name"].decode()
    model = dtb_model(data, h)
    rel = linux_release(data, h)
    want_rel = package_release()
    if want_rel and rel != want_rel:
        raise Refuse("the package image has kernel %s, %s says %s" % (rel or "?", RELEASE_FILE, want_rel))
    here = running_model()
    if model != here:
        raise Refuse("the package image is for %s, this unit is %s" % (model, here or "not a UC-P"))
    res, names, hb = boot_b_resource()
    res_sha = check_allowed(res, model)
    img = assemble(data, h, res)
    check_assembled(img, model)
    pa, a_token = boot_a_info()
    if len(img) > pa[1] * 512:
        raise Refuse("the image (%d bytes) is larger than boot_a" % len(img))
    sha = hashlib.sha256(img).hexdigest()
    say("package image: %s, kernel %s, model %s, token %s" % (BOOT_IMAGE, rel, model, token))
    say("resource from boot_b (header version %d): %d bytes, sha256 %s (approved for %s), entries %s"
        % (hb["version"], len(res), res_sha, model, " ".join(names)))
    say("image: %d bytes (limit %d), sha256 %s" % (len(img), MAX_IMAGE, sha))
    say("boot_a (%s): token %s" % (pa[0], a_token or "none"))
    return dict(token=token, model=model, release=rel, size=len(img), sha=sha, boot_a=pa, img=img)


def cmd_status():
    why = installed_panel()
    data = None
    try:
        data, h = load_template()
        model = dtb_model(data, h)
        say("package image: %s, kernel %s, model %s, token %s"
            % (BOOT_IMAGE, linux_release(data, h) or "?", model, h["name"].decode()))
    except Refuse as e:
        say(str(e))
        data = None
    if why:
        say("not on an installed UC-P panel (%s). Nothing to show from the eMMC." % why)
        return 0
    try:
        pa, a_token = boot_a_info()
        say("boot_a (%s): token %s" % (pa[0], a_token or "none"))
        res, names, hb = boot_b_resource()
        sha = hashlib.sha256(res).hexdigest()
        ok = any(sha in v for v in RESOURCES.values())
        say("boot_b: resource of %d bytes, sha256 %s (%s), entries %s"
            % (len(res), sha, "approved" if ok else "NOT approved", " ".join(names)))
        if data is not None:
            same = a_token == h["name"].decode()
            say("boot_a %s the kernel of the package" % ("holds" if same else "does NOT hold"))
            if not same:
                say("to write it: uc-pxx-update-boot write")
    except Refuse as e:
        say(str(e))
    for line in bootctl_status().splitlines():
        say("A/B: " + line)
    return 0


def cmd_hook():
    """Report for the package scripts. Never writes, always exits 0."""
    try:
        why = installed_panel()
        if why:
            say("not on an installed UC-P panel (%s). Nothing written." % why)
            return 0
        data, h = load_template()
        token = h["name"].decode()
        _, a_token = boot_a_info()
        if a_token == token:
            say("boot_a already holds this kernel (token %s). Nothing written." % token)
        else:
            say("the package has the kernel %s (token %s), boot_a has token %s."
                % (linux_release(data, h) or "?", token, a_token or "none"))
            say("The package writes nothing. To write boot_a: uc-pxx-update-boot write, then reboot.")
    except Refuse as e:
        say("%s. Nothing written." % e)
    except Exception as e:  # the package scripts must never fail
        say("hook error: %s. Nothing written." % e)
    return 0


def cmd_check():
    folder = run_folder()
    lock = take_lock(folder)
    try:
        f = prepare()
        clean_old_images(folder)
        path = save_image(folder, f["img"])
        if boot_a_holds(f["boot_a"], f["img"]):
            say("boot_a already holds this image. A write would change nothing.")
        else:
            say("check OK. The image is in %s (sha256 %s). Nothing written." % (path, f["sha"]))
        return 0
    finally:
        os.close(lock)


def confirm():
    if not sys.stdin.isatty():
        raise Refuse("no terminal to confirm: use --yes")
    say("Type yes to arm slot A and write boot_a:")
    return sys.stdin.readline().strip() == "yes"


def cmd_write(yes):
    # UC_PXX_TEST_NONROOT: host tests only (non-root). The wrappers need root anyway.
    if not IS_ROOT and not TEST_NONROOT:
        raise Refuse("must run as root")
    folder = run_folder()
    lock = take_lock(folder)
    try:
        return write_locked(folder, yes)
    finally:
        os.close(lock)


def write_locked(folder, yes):
    say("--- preflight (nothing is written in this step)")
    f = prepare()
    if boot_a_holds(f["boot_a"], f["img"]):
        say("boot_a already holds this image (sha256 %s). Nothing written." % f["sha"])
        return 0
    for line in bootctl_status().splitlines():
        say("A/B now: " + line)
    clean_old_images(folder)
    path = save_image(folder, f["img"])
    say("next: %s, then %s %s %s" % (ARM_SLOT, FLASH_BOOT, path, f["sha"]))
    if not yes and not confirm():
        safe_unlink(path)
        say("not confirmed. Nothing written.")
        return 1
    # From here until uc-pxx-flash-boot returns, no terminal signal stops the
    # tool or the wrappers (never cut a transfer short).
    old = {s: signal.signal(s, signal.SIG_IGN) for s in SIGNALS}
    try:
        say("--- arming slot A (uc-pxx-arm-slot)")
        try:
            rc = run_wrapper([ARM_SLOT])
        except OSError as e:
            safe_unlink(path)
            raise Refuse("cannot start %s: %s" % (ARM_SLOT, e.strerror))
        if rc != 0:
            safe_unlink(path)
            if rc < 0:
                say("uc-pxx-arm-slot was ended by signal %d. boot_a was not written. Check uc-pxx-bootctl status." % -rc)
                return 30
            say("uc-pxx-arm-slot exited with %d. boot_a was not written. Slot A may be armed (trying)." % rc)
            if rc == 3:
                say("the A/B state is unknown: do NOT reboot, read the message above.")
            return 10 + min(rc, 9)
        say("--- writing boot_a (uc-pxx-flash-boot)")
        try:
            rc = run_wrapper([FLASH_BOOT, path, f["sha"]])
        except OSError as e:
            say("cannot start %s: %s. Slot A is armed (trying), boot_a was not written." % (FLASH_BOOT, e.strerror))
            return 29
    finally:
        for s, h in old.items():
            signal.signal(s, h)
    if rc != 0:
        if rc < 0:
            say("uc-pxx-flash-boot was ended by signal %d. Slot A is trying, boot_a may be partial." % -rc)
            say("Do not reboot before uc-pxx-bootctl status shows slot A trying and slot B successful.")
            return 30
        say("uc-pxx-flash-boot exited with %d. Slot A was armed (trying)." % rc)
        say("boot_a may hold a partial or an old image. Do not mark the boot. A boot of slot A falls back to slot B.")
        say("Read the message of uc-pxx-flash-boot above before a reboot. The image stays in %s." % path)
        return 20 + min(rc, 9)
    safe_unlink(path)
    say("done: boot_a holds kernel %s (token %s). Slot A is trying." % (f["release"], f["token"]))
    say("Reboot to start it. After a healthy boot the hook marks slot A. A bad kernel falls back to slot B.")
    return 0


def cmd_assemble(template, resource, out):
    with open(template, "rb") as f:
        data = f.read()
    with open(resource, "rb") as f:
        res = f.read()
    h = check_template(data)
    model = dtb_model(data, h)
    if not 0 < len(res) <= MAX_RESOURCE:
        raise Refuse("the resource has %d bytes" % len(res))
    check_resource(res)
    check_allowed(res, model)
    img = assemble(data, h, res)
    check_assembled(img, model)
    with create_out(out) as f:
        f.write(img)
    say("%s: %d bytes, sha256 %s" % (out, len(img), hashlib.sha256(img).hexdigest()))
    return 0


def cmd_extract(bootimg, out):
    with open(bootimg, "rb") as f:
        data = f.read()
    h = parse_header(data[:4096])
    if not 0 < h["second_size"] <= MAX_RESOURCE or h["second_off"] + h["second_size"] > len(data):
        raise Refuse("%s has no usable second part" % bootimg)
    res = data[h["second_off"]:h["second_off"] + h["second_size"]]
    names = check_resource(res)
    sha = hashlib.sha256(res).hexdigest()
    with create_out(out) as f:
        f.write(res)
    ok = [m for m, v in RESOURCES.items() if sha in v]
    say("%s: %d bytes, sha256 %s (%s), entries %s" % (out, len(res), sha,
        "approved for " + " ".join(ok) if ok else "NOT approved for any model", " ".join(names)))
    return 0


def cmd_inspect(path):
    with open(path, "rb") as f:
        data = f.read()
    h = check_template(data)
    print("token=%s" % h["name"].decode())
    print("model=%s" % dtb_model(data, h))
    print("release=%s" % linux_release(data, h))
    print("size=%d" % len(data))
    return 0


def main(argv):
    args = argv[1:]
    try:
        if not args or args == ["status"]:
            return cmd_status()
        if args == ["--hook"]:
            return cmd_hook()
        if args == ["check"]:
            return cmd_check()
        if args[0] == "write" and args[1:] in ([], ["--yes"]):
            return cmd_write(args[1:] == ["--yes"])
        if args[0] == "assemble" and len(args) == 4:
            return cmd_assemble(*args[1:])
        if args[0] == "extract" and len(args) == 3:
            return cmd_extract(*args[1:])
        if args[0] == "inspect" and len(args) == 2:
            return cmd_inspect(args[1])
        if args[0] in ("-h", "--help"):
            print(__doc__)
            return 0
    except Refuse as e:
        say("%s. Nothing written." % e)
        return 1
    except OSError as e:
        say("%s. Nothing written." % e)
        return 1
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    rc = main(sys.argv)
    try:
        sys.stdout.flush()
    except OSError:
        pass
    sys.exit(rc)
