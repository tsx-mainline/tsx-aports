usr/sbin/uc-pxx-arm-slot
usr/sbin/uc-pxx-reboot
usr/sbin/uc-pxx-post-update
usr/sbin/uc-pxx-slot
"

# Pinned files: sha256, the path in the tag archive, the path in the package.
# check() and package() refuse other bytes, and scripts/check-apk-pins.sh
# checks the .apk; scripts/check-rules-pins.sh refuses a sha that the UC-P10
# safety rules do not name (uc-pxx/RULES-PINS). board.sh is the caller of
# uc-pxx-post-update (RULES pin); uc-pxx-lvm mounts /data and uc-pxx-firmware
# reads it (the both-slot release depends on them); the two writers of
# userdata of step 2 (proposed for the rules, MAINLINE-LINUX-INT-2026-11-10.md
# R-F.2). A changed copy needs a new review.
_pins="
15a610e7079ddad643bdacc0f744f348bef0ee965d2fb4e6d912e848f6e1ced2 tag:rootfs/overlay/usr/local/lib/tsx/board.sh usr/local/lib/tsx/board.sh
8f8632da42376defd3eabc5b11b5dd1d9121c97451e05feaa40b593c761eb4aa tag:rootfs/overlay/etc/init.d/uc-pxx-lvm etc/init.d/uc-pxx-lvm
4b808b4bb09e22933a4078082779aa59250a23a98a5eb9e886b2e3d5f49ed8b9 tag:rootfs/overlay/usr/local/sbin/uc-pxx-firmware usr/local/sbin/uc-pxx-firmware
9162c65df08ac5577e38a2fe124d8cb1434b9b2bcfe787d6fba76055b8006791 tag:rootfs/overlay/usr/sbin/uc-pxx-data-migrate usr/sbin/uc-pxx-data-migrate
0e94edad81775245c704153abf7bb0469ed88e9638324b9d798a2312539d853b tag:rootfs/overlay/usr/sbin/uc-pxx-data-release usr/sbin/uc-pxx-data-release
"

# _check_pins source|package: every pinned file has its sha256.
_check_pins() {
	local sum src dst f got bad=0
	while read -r sum src dst; do
		[ -n "$sum" ] || continue
		case $1:$src in
		source:tag:*) f=$builddir/${src#tag:};;
		package:*) f=$pkgdir/$dst;;
		*) error "bad pin line: $sum $src $dst"; return 1;;
		esac
		got=$(sha256sum "$f" 2>/dev/null | cut -d' ' -f1)
		if [ "$got" = "$sum" ]; then
			msg "pinned file OK: /$dst $sum"
		else
			error "pinned file CHANGED: $f has sha256 '$got', the pinned file has $sum"
			bad=1
		fi
	done <<-EOF
	$_pins
	EOF
	return $bad
}

prepare() {
	default_prepare
	(cd "$srcdir" && sha256sum -c CHECKSUMS.sha256) || { error "the tools bundle does not match its CHECKSUMS.sha256"; return 1; }
}

check() {
	_check_pins source
}

package() {
	local o=$builddir/rootfs/overlay f unknown
	unknown=$(cd "$o" && find . ! -type d | sed 's|^\./||' | while read -r f; do
		case " $(echo $_files $_others) " in *" $f "*) ;; *) echo "$f";; esac
	done)
	[ -z "$unknown" ] || { error "rootfs/overlay has files that no list of this recipe names: $unknown"; return 1; }
	for f in $_files; do
		# A link (panel-board.conf) stays a link. Its target need not exist
		# in the build.
		if [ -L "$o/$f" ]; then
			mkdir -p "$pkgdir/${f%/*}"
			ln -s "$(readlink "$o/$f")" "$pkgdir/$f"
			continue
		fi
		[ -f "$o/$f" ] || { error "board file missing in the source: $f"; return 1; }
		install -Dm"$(stat -c %a "$o/$f")" "$o/$f" "$pkgdir/$f"
	done
	install -Dm755 "$srcdir"/rtl8363-init "$pkgdir"/usr/sbin/rtl8363-init
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
	_check_pins package
}

