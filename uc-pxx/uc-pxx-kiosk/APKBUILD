# Meta package: it holds no files. It pulls the packages of the kiosk image
# profile of uc-pxx-linux (rootfs/profiles/kiosk.list). uc-pxx-leds waits for
# /run/tsx/kiosk.ready, which tsx-kiosk writes from the release after 0.3.10
# on. PLACEHOLDER: set the floor to that release.
pkgname=uc-pxx-kiosk
pkgver=0.1.0
pkgrel=0
pkgdesc="uc-pxx kiosk profile: console plus the Chromium kiosk and the setup page"
url="https://github.com/tsx-mainline/tsx-aports"
arch="aarch64"
license="GPL-2.0-or-later"
depends="uc-pxx-console>=0.1.0 tsx-kiosk>0.3.10 tsx-setup>0.3.11 chromium"
options="!check"

package() {
	mkdir -p "$pkgdir"
}
