# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Meta package: it holds no files. It pulls the packages of the console image
# profile of uc-pxx-linux (rootfs/profiles/console.list): the board, the boot
# control, the LEDs and the common base packages. The image build installs the
# kernel package uc-pxx-kernel-lts itself (rootfs/packages-tsx.txt), as on the
# xx70.
# The floors: the board hook of tsx-autoupdate, TSX_PKG_PREFIX and LED_MODE of
# tsx-buttons are in tsx-linux-common 0.3.12.
# 0.1.0-r1: the first public build (r0 was a private build).
pkgname=uc-pxx-console
pkgver=0.1.0
pkgrel=1
pkgdesc="uc-pxx console profile: text login on the panel, SSH, update tools and the hardware services"
url="https://github.com/tsx-mainline/tsx-aports"
arch="aarch64"
license="GPL-2.0-or-later"
depends="uc-pxx-board>=0.1.0 uc-pxx-boot-tools>=0.1.0 uc-pxx-leds>=0.1.0 tsx-base>=0.3.12 tsx-autoupdate>=0.3.12
	tsx-buttons>=0.3.12 tsx-idled tsx-splash"
options="!check"

package() {
	mkdir -p "$pkgdir"
}
