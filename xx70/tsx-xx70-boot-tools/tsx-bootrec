#!/bin/sh
# Crestron boot-side record, read and enforced by the stock LK on every boot.
# Raw eMMC sector 868350 (unpartitioned gap before aboot), 8 bytes:
#   [0] attempt counter while boot side != golden side (falls back at 11)
#   [1] attempt counter while boot side == golden side (flips at 4)
#   [2] golden side (0 = a, 1 = b)
#   [3] boot side   (0 = a, 1 = b) - LK makes this slot active every boot
#   [4..7] magic b0 07 51 66
#
# Usage: tsx-bootrec [show | reset | set <golden> <boot>]
set -e
dev=${TSX_BOOTREC_DEV:-/dev/mmcblk0}
off=$((868350 * 512))

show() { dd if=$dev bs=1 skip=$off count=8 2>/dev/null | hexdump -v -e '8/1 "%02x " "\n"'; }

magic_ok() { [ "$(show | cut -d' ' -f5-8)" = "b0 07 51 66" ]; }

case "${1:-show}" in
show)
	show
	;;
reset)
	magic_ok || { echo "tsx-bootrec: no valid record, not touching it" >&2; exit 1; }
	# no write when there is nothing to clear (this runs on every boot)
	[ "$(show | cut -d' ' -f1-2)" = "00 00" ] && { echo "tsx-bootrec: counters already clear: $(show)"; exit 0; }
	old=$(show)
	dd if=/dev/zero of=$dev bs=1 seek=$off count=2 conv=notrunc 2>/dev/null
	sync
	echo "tsx-bootrec: counters cleared: $old -> $(show)"
	;;
set)
	case "$2$3" in 00|01|10|11) ;; *) echo "usage: tsx-bootrec set <0|1> <0|1>" >&2; exit 1 ;; esac
	printf "\000\000\00$2\00$3\260\007\121\146" | dd of=$dev bs=1 seek=$off count=8 conv=notrunc 2>/dev/null
	sync
	echo "tsx-bootrec: $(show)"
	;;
*)
	echo "usage: tsx-bootrec [show | reset | set <golden> <boot>]" >&2
	exit 1
	;;
esac
