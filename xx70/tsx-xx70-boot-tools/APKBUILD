# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Boot image tools of the xx70 platform: tsx-update-boot and tsx-bootrec
# (vendored from tsx-xx70-linux rootfs/overlay/usr/local/sbin, keep them in
# step), tsx-kernel-flavor (show or switch the booted kernel flavor, also the
# hook of the tsx-xx70-kernel-* packages) and the tsx_is_installed_panel()
# helper. One package, so both kernel flavors share one copy.
pkgname=tsx-xx70-boot-tools
pkgver=1
pkgrel=2
pkgdesc="xx70 boot_b image update tools"
url="https://github.com/tsx-mainline/tsx-aports"
arch="aarch64"
license="GPL-2.0-or-later"
depends="busybox"
options="!check"
source="tsx-update-boot tsx-bootrec tsx-is-panel.sh tsx-kernel-flavor"

package() {
	install -Dm755 "$srcdir"/tsx-update-boot "$pkgdir"/usr/sbin/tsx-update-boot
	install -Dm755 "$srcdir"/tsx-bootrec "$pkgdir"/usr/sbin/tsx-bootrec
	install -Dm644 "$srcdir"/tsx-is-panel.sh "$pkgdir"/usr/lib/tsx/tsx-is-panel.sh
	install -Dm755 "$srcdir"/tsx-kernel-flavor "$pkgdir"/usr/sbin/tsx-kernel-flavor
}

sha512sums="
