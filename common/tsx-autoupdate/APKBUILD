# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Automatic update.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.6: the modes auto and manual, the setting AUTO_RESTART, the state
# "restart required" and release numbers as versions (the version of the board
# package tsx-<family>-board, else tsx-base). Depends on the settings and the
# override of tsx-base 0.3.6.
# 0.3.7: the release notes are a Markdown list, and the title and the latest
# version say "restart required" after an install that waits for a restart.
# 0.3.9: the 15-minute tick starts about 25 processes, not 280, and runs
# apk info -v once (the same output files).
# 0.3.11: "tsx-autoupdate status" shows the line "LED bar image" while a newer
# image waits for tsx-ledbar-fw-install.
pkgname=tsx-autoupdate
pkgver=0.3.11
pkgrel=0
pkgdesc="TSX automatic update of the panel packages"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
depends="tsx-base>=0.3.6 apk-tools curl python3"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/autoupdate/. "$pkgdir"/
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
}

sha512sums="
20a5294e79947903b827b67edff89a7cc3920439cbc52e0215bc3cca98d11e2ce9b1561747cc8485063ebbc085f46943b21513621f686e0c5512c15f59ef11ac  tsx-linux-common-0.3.11.tar.gz
"
