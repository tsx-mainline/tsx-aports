# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Idle and blank daemon, with the two tools that talk to it.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
#
# The files sit in the kiosk/ directory of tsx-linux-common, but every image
# profile runs them (the console profile too). So they are a package of their
# own, and tsx-kiosk does not install them. The console, kiosk and ha meta
# packages of each family pull this package.
# 0.3.8: tsx-display-power starts fewer processes for the repeated off. It is the
# only file that differs from 0.2.0.
# 0.3.13: tsx-idled reads the kiosk.conf layers with tsx-conf.h (defaults, board, user).
pkgname=tsx-idled
pkgver=0.3.13_pre20261113
pkgrel=0
pkgdesc="TSX idle daemon: backlight timeout, blank and wake, and the tsx-blank and tsx-display-power tools"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7 aarch64"
license="GPL-2.0-or-later"
depends="tsx-base>=0.3.13_pre20261113 brightnessctl"
makedepends="linux-headers"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

build() {
	cd "$builddir"/kiosk/src
	${CC:-gcc} $CFLAGS -O2 -Wall -o tsx-idled tsx-idled.c
}

package() {
	local k="$builddir"/kiosk
	install -Dm755 "$k"/src/tsx-idled "$pkgdir"/usr/local/sbin/tsx-idled
	install -Dm755 "$k"/etc/init.d/tsx-idled "$pkgdir"/etc/init.d/tsx-idled
	install -Dm755 "$k"/usr/local/bin/tsx-blank "$pkgdir"/usr/local/bin/tsx-blank
	install -Dm755 "$k"/usr/local/bin/tsx-display-power "$pkgdir"/usr/local/bin/tsx-display-power
}

sha512sums="
3168beb06c514e89c9277533c98504460d4ca717bd6f9be6eea759f48548b2d7b612bcac50577bad00a0c5956308057f2cf2ae26e63db06185fb9369c6921198  tsx-linux-common-0.3.13_pre20261113.tar.gz
"
