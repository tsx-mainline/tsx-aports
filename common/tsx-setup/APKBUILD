# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# On-panel setup page.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.10: the setup page has the Dark mode setting.
# 0.3.11: the setup page shows ORIENTATION_HW of hw.conf as the default orientation.
# 0.3.12: the setup page shows the distance field for a tof sensor only. Needs
# tsx_presence.py of tsx-base 0.3.12.
# 0.3.13: setup.conf moved to /usr/local/share/tsx/defaults. /etc/tsx/setup.conf holds
# only the changes of the user.
pkgname=tsx-setup
pkgver=0.3.13_pre20261108
pkgrel=0
pkgdesc="TSX on-panel setup page and its root helper"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
# tsx-setupd 0.3.4 needs the key HA_URL of tsx-config and `tsx-panelctl state`
# (the Panel section of the page) of tsx-base 0.3.4. 0.3.5: the group
# tsx-setup-screen may read the pairing code for the screen (the panel app).
depends="tsx-base>=0.3.13_pre20261108 python3"
install="$pkgname.pre-install $pkgname.pre-upgrade $pkgname.post-install $pkgname.post-upgrade"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/setup/. "$pkgdir"/
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
}

sha512sums="
26076df3bc3456e554ca40a282f5f5b45c8127f30f350600efc213e6ebac65aa4451d35538bcb62572d119dfe0d6d89978dab5e87294af7d85a073a748446bcb  tsx-linux-common-0.3.13_pre20261108.tar.gz
"
