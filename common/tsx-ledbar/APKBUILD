# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Host tools of the USB LED bar: the tool tsx-ledbar, the service tsx-ledbard
# with its init script, and ledbar.conf. The board file of the family gives
# the LED map of the bar (tsx_board_ledbar_map). The firmware of the bar is
# the separate package tsx-ledbar-fw.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.8: tsx-ledbard waits without a sleep process.
# 0.3.10: tsx-ledbar keeps every packet of a console answer, and tsx-ledbard names
# the colors whose LED chip did not start.
# 0.3.13: ledbar.conf moved to /usr/local/share/tsx/defaults. /etc/tsx/ledbar.conf holds
# only the changes of the user.
pkgname=tsx-ledbar
pkgver=0.3.13_pre20261113
pkgrel=0
pkgdesc="TSX USB LED bar: control tool, service and settings"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7 aarch64"
license="GPL-2.0-or-later"
depends="tsx-base>=0.3.13_pre20261113 libusb"
makedepends="libusb-dev linux-headers"
install="$pkgname.pre-upgrade $pkgname.post-install $pkgname.post-upgrade"
# Up to 0.1.5, the xx60 board package held these files.
replaces="tsx-xx60-board"
# The panel software lives in /usr/local, as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

build() {
	cd "$builddir"/ledbar/src
	${CC:-gcc} $CFLAGS -O2 -Wall -o tsx-ledbar tsx-ledbar.c -lusb-1.0
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/ledbar/. "$pkgdir"/
	rm -rf "$pkgdir"/src
	install -Dm755 "$builddir"/ledbar/src/tsx-ledbar "$pkgdir"/usr/local/bin/tsx-ledbar
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
}

sha512sums="
3168beb06c514e89c9277533c98504460d4ca717bd6f9be6eea759f48548b2d7b612bcac50577bad00a0c5956308057f2cf2ae26e63db06185fb9369c6921198  tsx-linux-common-0.3.13_pre20261113.tar.gz
"
