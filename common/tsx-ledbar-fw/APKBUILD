# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Open firmware for the USB LED bar (controller 14be:001b), and the tools
# that load it. The package is optional. The stock bar firmware stays the
# default. The firmware runs on the bar, not on the panel, so the package is
# noarch and the common index serves every family. Only the TSW-1060-LB bar
# is tested.
#
# The recipe does not compile the firmware. It packs the image of the GitHub
# release (tsx-ledbar-$pkgver.upg). GitHub Actions built that image from the
# tag with a pinned toolchain (GCC 14.2.1), and it was tested on a bar. A
# compile with the Alpine cross compiler (GCC 16) gives a different image that
# no one tested. The package holds no Crestron file. The stock image stays on
# the panel (/data/tsx/vendor/), and tsx-ledbar-fw-uninstall loads it back.
#
# Sources: the GitHub archive of the signed tag v$pkgver of tsx-ledbar-fw (the
# panel tools, the hooks and the tests), and the release asset
# tsx-ledbar-$pkgver.upg (the image). sha512sums holds the sum of each file.
# The release also has the sha256 of the image (SHA256SUMS) and BUILDINFO.
# After a new tag, run `abuild checksum` (README.md, "Source of the packages").
#
# 0.1.8: the LED chip start rework (0.1.6), the TSW-1070-LB map, the IMGUPD entry of
# tsx-ledbar-flash for stock v1.3443.00016, a port-reset of the port of the bar only,
# and an upgrade that never loads the bar.
#
# The install does not touch the bar. An upgrade does not load the new image
# either: when the bar runs the tsx-ledbar firmware, the post-upgrade file
# only writes /data/tsx/ledbar-fw.pending. A person runs tsx-ledbar-fw-install.
pkgname=tsx-ledbar-fw
pkgver=0.1.8
pkgrel=0
pkgdesc="TSX open firmware for the USB LED bar, with its loader and install scripts"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
depends="python3"
makedepends="python3"
# The panel tools live in /usr/local, as in the image.
options="!fhs"
install="$pkgname.post-upgrade"
source="tsx-ledbar-fw-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-ledbar-fw/archive/refs/tags/v$pkgver.tar.gz
	tsx-ledbar-$pkgver.upg::https://github.com/tsx-mainline/tsx-ledbar-fw/releases/download/v$pkgver/tsx-ledbar-$pkgver.upg"
builddir="$srcdir/tsx-ledbar-fw-$pkgver"

_lib=/usr/local/lib/tsx-ledbar-fw

build() {
	# Nothing to compile. The image is the release asset.
	return 0
}

check() {
	python3 "$builddir"/tests/test_upg.py
	# The image must pass the check of the tool that loads it.
	python3 "$builddir"/tools/tsx-upg.py verify "$srcdir"/tsx-ledbar-$pkgver.upg
}

package() {
	cd "$builddir"
	install -Dm644 "$srcdir"/tsx-ledbar-$pkgver.upg "$pkgdir"/usr/share/tsx-ledbar-fw/tsx-ledbar.upg
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm755 tools/tsx-ledbar-flash "$pkgdir"$_lib/tsx-ledbar-flash
	install -Dm755 tools/tsx-upg.py "$pkgdir"$_lib/tsx-upg.py
	install -Dm755 panel/tsx-ledbar-fw.post-upgrade "$pkgdir"$_lib/tsx-ledbar-fw.post-upgrade
	install -Dm755 panel/tsx-ledbar-fw-install "$pkgdir"/usr/local/sbin/tsx-ledbar-fw-install
	install -Dm755 panel/tsx-ledbar-fw-uninstall "$pkgdir"/usr/local/sbin/tsx-ledbar-fw-uninstall
	ln -s ../lib/tsx-ledbar-fw/tsx-ledbar-flash "$pkgdir"/usr/local/sbin/tsx-ledbar-flash
}

sha512sums="
80a1f4171bd562c1297120582b3752595c5644d327056aa9ad3f5b2fcc722c92773d77d0efc617c152dcd3f34b9c7aea649da0a3f3cab13883cd955204e9c014  tsx-ledbar-fw-0.1.8.tar.gz
f28e618794d31dfefc58a6bd7b9eee447f25a5ce9c508e751db2a4275d1f5aee39d400cb357b2db17505031d83b23690629b491f98ed46ffe9fbcf5f806d7e96  tsx-ledbar-0.1.8.upg
"
