# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Boot splash tool and frames.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.13: no change in this package. It follows the version of the archive.
pkgname=tsx-splash
pkgver=0.3.13_pre20261109
pkgrel=0
pkgdesc="TSX boot splash: framebuffer tool, splash frames and console fonts"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7 aarch64"
license="GPL-2.0-or-later"
makedepends="font-jetbrains-mono font-terminus fontconfig librsvg linux-headers py3-pillow"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"
# The screen sizes of the splash frames. mksplash.sh has no list of its own.
# Each family adds the sizes of its panels here, with the portrait size of
# each screen for a panel that hangs in portrait. xx60: 1280x800 (TSW-1060,
# TSS-10) and 1024x600 (TSW-760).
_sizes="1280x800 800x1280 1024x600 600x1024"

build() {
	cd "$builddir"/splash
	${CC:-gcc} $CFLAGS -O2 -Wall -o tsx-splash src/tsx-splash.c
	# mksplash.sh renders one frame for each size of _sizes and copies the fonts.
	sh ./mksplash.sh "$builddir"/splash-out $_sizes
}

package() {
	install -Dm755 "$builddir"/splash/tsx-splash "$pkgdir"/usr/local/bin/tsx-splash
	install -d "$pkgdir"/usr/share/tsx/splash
	install -m644 "$builddir"/splash-out/*.ppm "$builddir"/splash-out/*.psf \
		"$pkgdir"/usr/share/tsx/splash/
}

sha512sums="
b28e6ee2f831270dedb0e9dee230d16ec563f4437d9b61f95f96dea68f7338b3372533be83ef1d4aa546f3564c166bef41d7c91523851d109c7f9794c26b1239  tsx-linux-common-0.3.13_pre20261109.tar.gz
"
