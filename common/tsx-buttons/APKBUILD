# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Front-panel buttons daemon.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.12: LED_MODE=onoff and LED_KEY_N for key LEDs that are independent on/off LEDs.
# 0.3.13: buttons.conf moved to /usr/local/share/tsx/defaults. /etc/tsx/buttons.conf holds
# only the changes of the user.
# 0.3.13_pre20261122 (the release integration of 2026-11-22, tsx-linux-common
# d11b30e): the key action brightness N turns Auto brightness off, brightness
# auto turns it on (tsx-buttons.c 5868c785...). The sum is zeros until the tag
# v0.3.13_pre20261122 exists; then abuild checksum.
pkgname=tsx-buttons
pkgver=0.3.13_pre20261122
pkgrel=0
pkgdesc="TSX front-panel button daemon with its key map"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7 aarch64"
license="GPL-2.0-or-later"
depends="tsx-base>=0.3.13_pre20261113"
makedepends="linux-headers"
# The install scripts move buttons.conf to the split layout (see the files
# of the package). The old 0.1.x rule of the post-upgrade file is gone: a
# new version ships no buttons.conf, so no buttons.conf.apk-new appears.
install="$pkgname.pre-upgrade $pkgname.post-install $pkgname.post-upgrade"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

build() {
	${CC:-gcc} $CFLAGS -O2 -Wall -o "$builddir"/buttons/src/tsx-buttons "$builddir"/buttons/src/tsx-buttons.c
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/buttons/. "$pkgdir"/
	rm -rf "$pkgdir"/src
	install -Dm755 "$builddir"/buttons/src/tsx-buttons "$pkgdir"/usr/local/sbin/tsx-buttons
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
}

sha512sums="
58b331621f6ddcf3cabdd59c42c74195076bf662f94ca0c7ce30ece3ee4b7fba3d6e2c5796ce71a72ed74cbcdef08aef155c56fb820e392e7afabc7595ba907f  tsx-linux-common-0.3.13_pre20261122.tar.gz
"
