# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Third-party software (TensorFlow Lite). It keeps its own upstream license
# (Apache-2.0), not GPL-2.0-or-later.
#
# This recipe builds the package the same way that tsx-xx60-linux built it
# by hand (rootfs/voice/build-tflite.sh). The wheels pymicro-wakeword and
# pyopen-wakeword from PyPI contain an x86-64 glibc libtensorflowlite_c.so.
# This library does not load on an Alpine (musl) armv7 panel. This recipe
# uses the same cmake route as the script: the CMakeLists of tensorflow/lite/c,
# with XNNPACK, GPU, and NNAPI off, and no NEON (the Cortex-A9 has none). The
# result is a normal apk and not a hand-made part of the rootfs build.
# The recipe builds for armv7 and aarch64. The CMake build of TFLite is not
# specific to an architecture. On aarch64 the build adds -mcpu=cortex-a53
# (for example the APQ8053). NEON is in the aarch64 base ISA, so no FPU flag.
#
# musl has no strtoll_l. The build sets FLATBUFFERS_LOCALE_INDEPENDENT=0 for
# flatbuffers (see build-tflite.sh).
#
# The armv7 library is the pinned library of tsx-xx60-linux
# (rootfs/voice/tflite/SHA256SUMS), byte for byte. The recipe uses the flags
# of build-tflite.sh and not the flags of abuild: -O2 -fPIC, no LDFLAGS, and
# a plain strip. The source paths and the paths of the parts that CMake
# fetches get into the library (__FILE__, assert texts). So the build maps the
# source folder to /build/tensorflow-$pkgver and the CMake build folder to
# /build/tflite, the two folder names of build-tflite.sh. package() stops when
# the armv7 library does not have the sha256 of _pin_armv7. Change the pin in
# both repositories together.
#
# The CMake build of TFLite fetches several third-party dependencies itself
# (abseil, flatbuffers, farmhash, fft2d, gemmlowp, ruy, cpuinfo, and others).
# It uses CMake FetchContent or ExternalProject at configure time. For this
# reason the recipe has options="net", like sendspin-cli for its own
# FetchContent dependencies.
pkgname=tensorflow-lite-c
pkgver=2.17.1
pkgrel=1
pkgdesc="TensorFlow Lite C API shared library and headers"
url="https://www.tensorflow.org/lite"
arch="armv7 aarch64"
license="Apache-2.0"
makedepends="build-base cmake samurai git curl python3 linux-headers patch"
options="net !check !strip"
source="tensorflow-$pkgver.tar.gz::https://github.com/tensorflow/tensorflow/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tensorflow-$pkgver"
_pin_armv7=e3fb7cad5bafd7ce39d5efd16774f1a0c4361ffd576c26c1102bf49a8d3f6b64

build() {
	local opt="-O2"
	case "$CARCH" in
	aarch64) opt="-O2 -mcpu=cortex-a53";;
	esac
	# CMake reads these from the environment. The pinned build has none.
	unset CFLAGS CPPFLAGS CXXFLAGS LDFLAGS
	local b="$srcdir"/tflite-build
	local map="-ffile-prefix-map=$builddir=/build/tensorflow-$pkgver -ffile-prefix-map=$b=/build/tflite"
	cmake -S "$builddir/tensorflow/lite/c" -B "$b" -G Ninja \
		-DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DTFLITE_ENABLE_XNNPACK=OFF -DTFLITE_ENABLE_GPU=OFF \
		-DTFLITE_ENABLE_NNAPI=OFF -DTFLITE_ENABLE_MMAP=ON \
		-DCMAKE_C_FLAGS="$opt -fPIC $map" \
		-DCMAKE_CXX_FLAGS="$opt -fPIC -Wno-error -DFLATBUFFERS_LOCALE_INDEPENDENT=0 $map"
	cmake --build "$b" --target tensorflowlite_c
}

package() {
	cd "$builddir"
	local lib="$pkgdir"/usr/lib/libtensorflowlite_c.so sum
	install -Dm755 "$srcdir"/tflite-build/libtensorflowlite_c.so "$lib"
	strip "$lib"
	sum=$(sha256sum "$lib" | cut -d' ' -f1)
	echo "libtensorflowlite_c.so $CARCH sha256 $sum"
	if [ "$CARCH" = armv7 ] && [ "$sum" != "$_pin_armv7" ]; then
		error "libtensorflowlite_c.so does not match the pin $_pin_armv7"
		return 1
	fi
	# The soname symlink: create it only if the upstream build set a soname.
	# It may not, because the CMakeLists of tensorflow/lite/c does not
	# always set VERSION or SOVERSION.
	soname=$(readelf -d "$lib" 2>/dev/null | \
		sed -n 's/.*(SONAME).*\[\(.*\)\].*/\1/p')
	if [ -n "$soname" ] && [ "$soname" != "libtensorflowlite_c.so" ]; then
		ln -s libtensorflowlite_c.so "$pkgdir/usr/lib/$soname"
	fi
	# C API headers. Recent TFLite versions split the public C API headers
	# between tensorflow/lite/c/ and tensorflow/lite/core/(async/)c/. The
	# first directory includes the second. Install each of these directories
	# that exists, and keep the real tree. Then both
	# `#include <tensorflow/lite/c/*.h>` and the internal includes work for
	# other consumers.
	for d in tensorflow/lite/c tensorflow/lite/core/c tensorflow/lite/core/async/c; do
		[ -d "$d" ] || continue
		install -d "$pkgdir/usr/include/$d"
		install -m644 "$d"/*.h "$pkgdir/usr/include/$d/"
	done
}

sha512sums="
de7e536e9b51e1fbf24b9dbe851026c4be4b6cf9f64069a8ed48feac47564db54b6d4c88022eabfb4dbbc72d9842b8f2d82400ad1bc81487b018fbdde70e4ef2  tensorflow-2.17.1.tar.gz
"
