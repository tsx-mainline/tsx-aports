# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Base services of every TSX panel image: config, hostname, data, clock, banner, panelctl.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
pkgname=tsx-base
pkgver=0.2.0
pkgrel=2
pkgdesc="TSX panel base system: config, hostname, data, clock, banner and the hardware seam"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
# The board package of the family adds /usr/local/lib/tsx/board.sh.
depends="busybox busybox-openrc openrc chrony curl e2fsprogs eudev ifupdown-ng logrotate openssh-server tzdata"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
# tsx_brightness.py moved from tsx-kiosk to this package in 0.1.4.
replaces="busybox busybox-openrc chrony-common chrony-openrc tsx-kiosk"
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/base/. "$pkgdir"/
}

sha512sums="
97123b7ac4fa1b72deb20291a562b3d0159ec1577efbf8ae1eead721de43b355f9a66cdf46db1a00742866fda83926a9448e39f7443cb688a0e0a64957c28d3e  tsx-linux-common-0.2.0.tar.gz
"
