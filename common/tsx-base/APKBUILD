# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Base services of every TSX panel image: config, hostname, data, clock, banner, panelctl.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
# 0.3.7: tsx-panelctl starts "tsx-autoupdate now" detached, so no zombie stays.
# 0.3.8: tsx-banner waits for inotify events (no check every 3 s). A client call
# of tsx-panelctl starts no date process.
# 0.3.10: the kiosk dark mode setting (KIOSK_DARK) in tsx-config and tsx-panelctl,
# and the init script tsx-setup reads the time zone file of the card tool.
# 0.3.11: tsx-config apply and the setup page use ORIENTATION_HW of hw.conf as the
# default of ORIENTATION, for a board that reports a hardware orientation.
# 0.3.12: PRESENCE of hw.conf is the kind of the presence sensor (no, tof or pir;
# a missing key means no sensor), presence-kind.sh and tsx_presence.py, and
# tsx-panelctl reboot with the restart block of tsx-autoupdate.
# 0.3.13: tsx-conf-migrate, conf.sh and tsx_conf.py for the settings files with a defaults
# layer, and the old defaults in defaults/pre-split. base/src (tsx-conf.h) is source for
# other packages and does not go on the panel.
# 0.3.13_pre20261117: the root password note once per interactive root login, in
# words for a person who is logged in (tsx-rootpw note ssh); /etc/motd without it.
# 0.3.13_pre20261118: tsx-config takes a board default for BT_ACTIVE
# (TSX_BT_ACTIVE_DEFAULT of board.sh; off when the board file has none).
# 0.3.13_pre20261122 (the release integration of 2026-11-22, tsx-linux-common
# d11b30e): a fixed level (HA Backlight, brightness N / brightness-pct P) turns
# Auto brightness off and Auto on clears the fixed level and the offset
# (tsx-panelctl 10ba58ac..., tsx-config 1ba3498f...); learning shifts the curve
# instead of flattening it and the learn file records its basis
# (tsx_brightness.py 9a5a5c2e...); udhcpc-opts -A 3 (a DHCP retry after 3 s).
# The sum is zeros until the tag v0.3.13_pre20261122 exists; then abuild checksum.
pkgname=tsx-base
pkgver=0.3.13_pre20261122
pkgrel=0
pkgdesc="TSX panel base system: config, hostname, data, clock, banner and the hardware seam"
url="https://github.com/tsx-mainline/tsx-aports"
arch="noarch"
license="GPL-2.0-or-later"
# The board package of the family adds /usr/local/lib/tsx/board.sh.
depends="busybox busybox-openrc openrc chrony curl e2fsprogs eudev ifupdown-ng logrotate openssh-server tzdata"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
# tsx_brightness.py moved from tsx-kiosk to this package in 0.1.4.
replaces="busybox busybox-openrc chrony-common chrony-openrc tsx-kiosk"
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/base/. "$pkgdir"/
	# base/src holds tsx-conf.h. Other packages include it at build time.
	rm -rf "$pkgdir"/src
	# The GitHub archive of a tag has group-writable files. tsx-config and the
	# plugin loader of tsx-ha refuse a group-writable plugin.
	chmod -R go-w "$pkgdir"
}

sha512sums="
58b331621f6ddcf3cabdd59c42c74195076bf662f94ca0c7ce30ece3ee4b7fba3d6e2c5796ce71a72ed74cbcdef08aef155c56fb820e392e7afabc7595ba907f  tsx-linux-common-0.3.13_pre20261122.tar.gz
"
