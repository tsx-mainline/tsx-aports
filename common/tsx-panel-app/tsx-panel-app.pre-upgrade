#!/bin/sh
# The program of the panel app runs as its own user (docs/security.md of
# tsx-linux-common): the display (video), the touch and the keys (input),
# the sound (audio) and the pairing code of the setup page
# (tsx-setup-screen, which tsx-setup makes). The service gives it its folders
# and its sysfs files before each start.
getent group tsx-panel-app >/dev/null || addgroup -S tsx-panel-app
if ! getent passwd tsx-panel-app >/dev/null; then
	adduser -S -D -H -h /dev/null -s /sbin/nologin -G tsx-panel-app -g "panel app" tsx-panel-app
fi
for g in video input audio tsx-setup-screen; do
	addgroup tsx-panel-app $g 2>/dev/null || true
done
# Up to 0.3.12, this package held the full settings file in /etc. A new version
# does not ship it, so apk deletes an unedited file and keeps an edited one with
# no owner. Copy the old file to the folder that tsx-conf-migrate reads. The
# post-upgrade script runs the tool. The tool compares the copy with the old
# defaults, so an unedited file becomes a short header.
d=/usr/local/share/tsx/defaults
for n in panel-app.conf; do
	case $n in kiosk.conf) f=/etc/kiosk.conf;; *) f=/etc/tsx/$n;; esac
	if [ ! -e "$d/$n" ] && [ -f "$f" ]; then
		mkdir -p /var/lib/tsx/conf-migrate
		cp -p "$f" "/var/lib/tsx/conf-migrate/$n" || true
	fi
done
exit 0
