# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Kiosk session and its C helper (the quick-settings overlay). tsx-idled is a package of its own.
#
# Source: the signed tag v$pkgver of tsx-linux-common. The build downloads the
# GitHub archive of that tag. sha512sums holds the sum of the archive. After a
# new tag, run `abuild checksum` (README.md, "Source of the packages").
pkgname=tsx-kiosk
pkgver=0.2.0
pkgrel=1
pkgdesc="TSX kiosk: session script, orientation, on-screen keyboard and quick-settings overlay"
url="https://github.com/tsx-mainline/tsx-aports"
arch="armv7 aarch64"
license="GPL-2.0-or-later"
# The browser and the compositor patch are family packages (the meta package
# tsx-<family>-kiosk adds them).
depends="tsx-base tsx-idled tsx-splash brightnessctl cairo curl font-dejavu libinput mesa-dri-gallium mesa-egl
	mesa-gbm mesa-gles python3 seatd seatd-openrc squeekboard sway swaybg wayland-libs-client wlr-randr
	wvkbd-mobintl"
makedepends="cairo-dev linux-headers wayland-dev wayland-protocols wlr-protocols"
install="$pkgname.pre-install $pkgname.post-install"
# The panel software lives in /usr/local (and /opt/lva for the voice shim), as in the image.
replaces="alpine-baselayout"
options="!check !fhs"
source="tsx-linux-common-$pkgver.tar.gz::https://github.com/tsx-mainline/tsx-linux-common/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/tsx-linux-common-$pkgver"

build() {
	cd "$builddir"/kiosk/src
	# tsx-overlay is a layer-shell client. The layer-shell protocol comes from
	# wlr-protocols. The overlay also needs the xdg-shell glue code.
	mkdir -p proto
	local ls=/usr/share/wlr-protocols/unstable/wlr-layer-shell-unstable-v1.xml
	wayland-scanner client-header $ls proto/wlr-layer-shell-unstable-v1-client-protocol.h
	wayland-scanner private-code $ls proto/wlr-layer-shell-unstable-v1-protocol.c
	wayland-scanner private-code /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
		proto/xdg-shell-protocol.c
	${CC:-gcc} $CFLAGS -O2 -Wall -Iproto -o tsx-overlay tsx-overlay.c proto/*.c \
		$(pkg-config --cflags --libs cairo wayland-client) -lm
}

package() {
	mkdir -p "$pkgdir"
	cp -a "$builddir"/kiosk/. "$pkgdir"/
	rm -rf "$pkgdir"/src
	# tsx-idled and its two tools are the package tsx-idled (every profile runs them).
	rm -f "$pkgdir"/etc/init.d/tsx-idled "$pkgdir"/usr/local/bin/tsx-blank "$pkgdir"/usr/local/bin/tsx-display-power
	install -Dm755 "$builddir"/kiosk/src/tsx-overlay "$pkgdir"/usr/local/bin/tsx-overlay
	_cursors
}

# The blank cursor theme (/usr/share/tsx/cursors). The kiosk hides the pointer
# with it. The theme has one 1x1 fully transparent Xcursor image. The image
# build made it before. The package makes it now.
_cursors() {
	local t="$pkgdir"/usr/share/tsx/cursors n
	local c="$t"/blank/cursors
	mkdir -p "$c"
	printf 'Xcur\020\000\000\000\000\000\001\000\001\000\000\000' > "$c"/left_ptr
	printf '\002\000\375\377\030\000\000\000\034\000\000\000' >> "$c"/left_ptr
	printf '\044\000\000\000\002\000\375\377\030\000\000\000\001\000\000\000' >> "$c"/left_ptr
	printf '\001\000\000\000\001\000\000\000\000\000\000\000\000\000\000\000\000\000\000\000' >> "$c"/left_ptr
	printf '\000\000\000\000' >> "$c"/left_ptr
	for n in default arrow top_left_arrow pointer hand hand1 hand2 text xterm ibeam crosshair \
		 wait watch progress grab grabbing move all-scroll not-allowed col-resize row-resize \
		 e-resize w-resize n-resize s-resize ns-resize ew-resize nesw-resize nwse-resize \
		 context-menu help cell copy alias no-drop vertical-text zoom-in zoom-out; do
		ln -sf left_ptr "$c"/$n
	done
	printf '[Icon Theme]\nName=blank\n' > "$t"/blank/index.theme
	ln -sfn blank "$t"/default
}

sha512sums="
97123b7ac4fa1b72deb20291a562b3d0159ec1577efbf8ae1eead721de43b355f9a66cdf46db1a00742866fda83926a9448e39f7443cb688a0e0a64957c28d3e  tsx-linux-common-0.2.0.tar.gz
"
