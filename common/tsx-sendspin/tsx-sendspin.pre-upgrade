#!/bin/sh
# The player runs as its own user in the group audio (docs/security.md of
# tsx-linux-common). Up to 0.3.4 it ran as the user kiosk.
if ! getent passwd tsx-sendspin >/dev/null; then
	adduser -S -D -H -h /dev/null -s /sbin/nologin -G audio -g "Sendspin player" tsx-sendspin
fi
# Up to 0.3.12, this package held the full settings file in /etc. A new version
# does not ship it, so apk deletes an unedited file and keeps an edited one with
# no owner. Copy the old file to the folder that tsx-conf-migrate reads. The
# post-upgrade script runs the tool. The tool compares the copy with the old
# defaults, so an unedited file becomes a short header.
d=/usr/local/share/tsx/defaults
for n in sendspin.conf; do
	case $n in kiosk.conf) f=/etc/kiosk.conf;; *) f=/etc/tsx/$n;; esac
	if [ ! -e "$d/$n" ] && [ -f "$f" ]; then
		mkdir -p /var/lib/tsx/conf-migrate
		cp -p "$f" "/var/lib/tsx/conf-migrate/$n" || true
	fi
done
exit 0
