+/// How long the main loop waits between ticks.
+
+#pragma once
+
+#include <sendspin/client.h>
+
+#include <atomic>
+
+namespace sendspin_cli {
+
+/// Main-loop interval while a stream plays or a time-sync burst runs.
+constexpr int ACTIVE_LOOP_INTERVAL_MS = 10;
+
+/// Main-loop interval while the player is idle. An idle daemon then wakes the CPU 10 times a
+/// second instead of 100. A control request still wakes the loop at once (ControlSocket::wait()).
+constexpr int IDLE_LOOP_INTERVAL_MS = 100;
+
+/// Picks the main-loop interval from the library's high-performance requests.
+///
+/// sendspin-cpp asks for high performance while it plays a stream and while it runs a time-sync
+/// burst, the two cases where a 10 ms tick matters (an ESPHome host speeds up its loop for the
+/// same requests). Between them the library only drains its inbox and runs second-scale timers,
+/// so a longer wait loses nothing but up to IDLE_LOOP_INTERVAL_MS before a server message (for
+/// example stream/start) is handled. Its audio carries play-at timestamps, so that delay does
+/// not move the audio.
+class LoopPacer : public sendspin::SendspinClientListener {
+public:
+    /// The library ref-counts its requests and calls these on the 0->1 and 1->0 edges only. The
+    /// release can fire inside the connection-loss path, so both only store a flag.
+    void on_request_high_performance() override {
+        this->high_performance_.store(true);
+    }
+
+    void on_release_high_performance() override {
+        this->high_performance_.store(false);
+    }
+
+    /// Milliseconds to wait before the next tick.
+    int interval_ms() const {
+        return this->high_performance_.load() ? ACTIVE_LOOP_INTERVAL_MS : IDLE_LOOP_INTERVAL_MS;
+    }
+
+private:
+    std::atomic<bool> high_performance_{false};
+};
+
+}  // namespace sendspin_cli
