+void ControlSocket::wait(int timeout_ms) const {
+    if (timeout_ms <= 0) {
+        return;
+    }
+    if (this->impl_->listener < 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(timeout_ms));
+        return;
+    }
+    std::vector<pollfd> fds;
+    fds.reserve(1 + this->impl_->connections.size());
+    fds.push_back(pollfd{this->impl_->listener, POLLIN, 0});
+    for (const Connection& connection : this->impl_->connections) {
+        fds.push_back(pollfd{connection.fd, POLLIN, 0});
+    }
+    // EINTR (a signal) just ends the wait early; the loop then checks g_running.
+    static_cast<void>(::poll(fds.data(), static_cast<nfds_t>(fds.size()), timeout_ms));
+}
