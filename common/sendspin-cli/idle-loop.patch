+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+namespace sendspin_cli {
+namespace {
+
+int64_t elapsed_ms(std::chrono::steady_clock::time_point since) {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                                 since)
+        .count();
+}
+
+/// A socket path under the build tree, per test, removed afterwards with its lock.
+class ScratchSocket {
+public:
+    ScratchSocket()
+        : path_("loop-pacer-test-" + std::to_string(getpid()) + "-" +
+                std::to_string(ScratchSocket::next_id()) + ".sock") {}
+
+    ~ScratchSocket() {
+        std::remove(this->path_.c_str());
+        std::remove((this->path_ + ".lock").c_str());
+    }
+
+    ScratchSocket(const ScratchSocket&) = delete;
+    ScratchSocket& operator=(const ScratchSocket&) = delete;
+
+    const std::string& path() const {
+        return this->path_;
+    }
+
+private:
+    static int next_id() {
+        static int id = 0;
+        return id++;
+    }
+
+    std::string path_;
+};
+
+int connect_to(const std::string& path) {
+    const int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return -1;
+    }
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    if (::connect(fd, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) != 0) {
+        ::close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+TEST(LoopPacer, AnIdlePlayerTicksSlowly) {
+    const LoopPacer pacer;
+    EXPECT_EQ(pacer.interval_ms(), IDLE_LOOP_INTERVAL_MS);
+}
+
+TEST(LoopPacer, HighPerformanceTicksFastUntilReleased) {
+    LoopPacer pacer;
+    pacer.on_request_high_performance();
+    EXPECT_EQ(pacer.interval_ms(), ACTIVE_LOOP_INTERVAL_MS);
+    pacer.on_release_high_performance();
+    EXPECT_EQ(pacer.interval_ms(), IDLE_LOOP_INTERVAL_MS);
+}
+
+TEST(LoopPacer, TheActiveTickIsTheOldFixedTick) {
+    // Playback keeps the 10 ms tick it always had; only the idle tick is longer.
+    EXPECT_EQ(ACTIVE_LOOP_INTERVAL_MS, 10);
+    EXPECT_GT(IDLE_LOOP_INTERVAL_MS, ACTIVE_LOOP_INTERVAL_MS);
+}
+
+TEST(ControlSocketWait, WithNothingWaitingItWaitsTheTimeout) {
+    const ScratchSocket scratch;
+    ControlSocket socket;
+    std::string error;
+    ASSERT_EQ(socket.open(scratch.path(), error), ControlSocketStatus::Ok) << error;
+
+    const auto start = std::chrono::steady_clock::now();
+    socket.wait(60);
+    EXPECT_GE(elapsed_ms(start), 50);
+}
+
+TEST(ControlSocketWait, AConnectionEndsTheWaitAtOnce) {
+    const ScratchSocket scratch;
+    ControlSocket socket;
+    std::string error;
+    ASSERT_EQ(socket.open(scratch.path(), error), ControlSocketStatus::Ok) << error;
+
+    const int client = connect_to(scratch.path());
+    ASSERT_GE(client, 0);
+    const auto start = std::chrono::steady_clock::now();
+    socket.wait(5000);
+    EXPECT_LT(elapsed_ms(start), 1000);
+    ::close(client);
+}
+
+TEST(ControlSocketWait, WithoutASocketItOnlySleeps) {
+    const ControlSocket socket;
+    const auto start = std::chrono::steady_clock::now();
+    socket.wait(30);
+    EXPECT_GE(elapsed_ms(start), 25);
+}
