+TEST(VolumeFile, WritesThePairInTheStateFormatReadableByEveryone) {
+    const ScratchDir scratch;
+    ASSERT_TRUE(scratch.created());
+
+    // The same format as the state file, so the same reader takes it.
+    ASSERT_TRUE(write_volume_file(scratch.file(), 40, true));
+    StateStore reread = loaded(scratch.file());
+    EXPECT_EQ(reread.volume(), 40);
+    EXPECT_EQ(reread.muted(), true);
+
+    // Rewritten in place, not appended to.
+    ASSERT_TRUE(write_volume_file(scratch.file(), 0, false));
+    reread = loaded(scratch.file());
+    EXPECT_EQ(reread.volume(), 0);
+    EXPECT_EQ(reread.muted(), false);
+
+    // 0644 whatever the umask: other programs read it, unlike the 0600 state file.
+    const mode_t previous = ::umask(077);
+    ASSERT_TRUE(write_volume_file(scratch.file(), 55, false));
+    ::umask(previous);
+    struct stat info = {};
+    ASSERT_EQ(::stat(scratch.file().c_str(), &info), 0);
+    EXPECT_EQ(info.st_mode & 0777, 0644U);
+}
+
+TEST(VolumeFile, AnEmptyPathWritesNothing) {
+    EXPECT_FALSE(write_volume_file("", 40, false));
+}
