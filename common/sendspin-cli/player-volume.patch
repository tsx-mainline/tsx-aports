@@ -126,4 +157,24 @@ void PlayerListener::persist_volume() const {
     this->store_->set_volume_and_muted(this->applied_volume_, this->applied_muted_);
 }
 
+void PlayerListener::publish_volume() {
+    if (this->volume_file_.empty()) {
+        return;
+    }
+    const std::pair<uint8_t, bool> pair{this->applied_volume_, this->applied_muted_};
+    if (this->published_volume_ == pair) {
+        return;
+    }
+    if (!write_volume_file(this->volume_file_, pair.first, pair.second)) {
+        // Once per run: a volume drag would otherwise repeat it for every step.
+        if (!this->volume_file_warned_) {
+            cli_log(LogLevel::WARN, "Could not write the volume file %s",
+                    this->volume_file_.c_str());
+        }
+        this->volume_file_warned_ = true;
+        return;
+    }
+    this->published_volume_ = pair;
+}
+
 }  // namespace sendspin_cli
