+void PlayerListener::set_local_volume(uint8_t volume) {
+    this->sink_.set_volume(volume);
+    this->applied_volume_ = volume;
+    this->volume_source_ = VolumeSource::Local;
+    this->persist_volume();
+    this->publish_volume();
+    // Publishes client/state, so the server learns the new volume; no-op while disconnected,
+    // and the next handshake reports it then.
+    this->player_.update_volume(volume);
+    cli_log(LogLevel::INFO, "Player volume set to %u locally", static_cast<unsigned>(volume));
+}
+
+void PlayerListener::set_local_muted(bool muted) {
+    this->sink_.set_muted(muted);
+    this->applied_muted_ = muted;
+    this->volume_source_ = VolumeSource::Local;
+    this->persist_volume();
+    this->publish_volume();
+    this->player_.update_muted(muted);
+    cli_log(LogLevel::INFO, "Player %s locally", muted ? "muted" : "unmuted");
+}
+
+void PlayerListener::set_volume_file(const std::string& path) {
+    this->volume_file_ = path;
+    this->published_volume_.reset();
+    this->publish_volume();
 }
 
