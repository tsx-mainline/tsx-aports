+/// Replaces `path` with `pairs` as `key = value` lines, atomically and at exactly `mode`.
+bool write_key_value_file(const std::string& path, mode_t mode,
+                          const std::vector<std::pair<std::string, std::string>>& pairs) {
+    // Pid in the name, so two players sharing a directory cannot rename each other's temp file.
+    const std::string temporary = path + ".tmp." + std::to_string(getpid());
+    // Remove a stale temp so O_EXCL creates the file with our mode.
+    std::remove(temporary.c_str());
+
+    // At `mode` from creation, so the file is never readable more widely; fchmod undoes the umask.
+    const int fd = ::open(temporary.c_str(), O_WRONLY | O_CREAT | O_EXCL, mode);
+    if (fd < 0) {
+        return false;
+    }
+    std::FILE* file = ::fdopen(fd, "w");
+    if (file == nullptr) {
+        ::close(fd);
+        std::remove(temporary.c_str());
+        return false;
+    }
+
+    bool ok = ::fchmod(fd, mode) == 0;
+    ok = ok && std::fprintf(file, "# Written by sendspin-cli. Edits are overwritten.\n") > 0;
+    for (const auto& [key, value] : pairs) {
+        if (!ok) {
+            break;
+        }
+        ok = std::fprintf(file, "%s = %s\n", key.c_str(), value.c_str()) > 0;
+    }
+    // fsync before rename, or a power cut can leave an empty file in place.
+    if (ok) {
+        ok = std::fflush(file) == 0 && ::fsync(fd) == 0;
+    }
+    // fclose also flushes, so a full disk can surface here.
+    ok = std::fclose(file) == 0 && ok;
+
