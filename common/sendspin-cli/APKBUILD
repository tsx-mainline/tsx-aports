# Contributor: unex <7575866+unex@users.noreply.github.com>
# Maintainer: unex <7575866+unex@users.noreply.github.com>
# Third-party software (Sendspin/sendspin-cpp-cli). It keeps its own upstream
# license (see license= below), not GPL-2.0-or-later.
#
# This recipe builds the package the same way that the rootfs of the project
# built it by hand (rootfs/src/sendspin/build.sh in tsx-xx60-linux, with the
# same pinned tag and the same cmake flags). The targets are musl/armv7 and musl/aarch64. The
# dependencies ArduinoJson, micro-flac, micro-opus, and IXWebSocket are
# statically linked. CMake fetches them (FetchContent) at configure time, so
# the build needs network access: options="net".
#
# player-volume.patch (written for upstream): the subcommands player-vol and
# player-mute set the player volume and mute of this endpoint over the control
# socket (the server is told through client/state), and --volume-file
# publishes the applied volume and mute in a file (mode 0644) at each change.
# The panel volume of tsx-panelctl and the panel app use them when the
# Sendspin player runs (docs/sendspin.md of tsx-linux-common).
#
# idle-loop.patch (written for upstream): the main loop ticks every 10 ms only
# while sendspin-cpp asks for high performance (a stream plays, a time-sync
# burst runs) and every 100 ms while the player is idle. A control request
# ends the wait at once. An idle player woke the CPU 100 times a second
# before: about 3.5 % of the CPU of an xx50 panel at 167 MHz.
pkgname=sendspin-cli
pkgver=0.3.0
pkgrel=2
pkgdesc="Sendspin CLI client (C++)"
url="https://github.com/Sendspin/sendspin-cpp-cli"
arch="armv7 aarch64"
license="MIT"
depends="alsa-lib avahi avahi-compat-libdns_sd dbus"
makedepends="build-base cmake samurai git linux-headers alsa-lib-dev avahi-compat-libdns_sd avahi-dev"
options="net !check"
source="$pkgname-$pkgver.tar.gz::https://github.com/Sendspin/sendspin-cpp-cli/archive/refs/tags/v$pkgver.tar.gz
	player-volume.patch
	idle-loop.patch
	"
builddir="$srcdir/sendspin-cpp-cli-$pkgver"

build() {
	# Pick the CPU flags for each architecture. armv7 is the Cortex-A9 with
	# NEON. aarch64 is the Cortex-A53 (APQ8053), which has NEON in the base
	# ISA, so it needs no FPU flag.
	case "$CARCH" in
	armv7) cpuflags="-mcpu=cortex-a9 -mfpu=neon";;
	aarch64) cpuflags="-mcpu=cortex-a53";;
	*) cpuflags="";;
	esac
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS="$CFLAGS $cpuflags" \
		-DCMAKE_CXX_FLAGS="$CXXFLAGS $cpuflags" \
		-DSENDSPIN_CLI_WITH_PORTAUDIO=OFF \
		-DSENDSPIN_CLI_WITH_PULSE=OFF \
		-DSENDSPIN_CLI_WITH_PIPEWIRE=OFF
	cmake --build build
}

package() {
	install -Dm755 build/sendspin-cli "$pkgdir"/usr/bin/sendspin-cli
}

